{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "FreshRSS",
      "type": "object",
      "required": [
        "subdomain"
      ],
      "properties": {
        "subdomain": {
          "type": "string",
          "title": "Subdomain",
          "format": "tunnel",
          "default": "freshrss"
        },
        "storage_size": {
          "type": "string",
          "title": "Storage size",
          "default": "5Gi",
          "description": "How much CephFS storage to allocate (e.g. 20Gi, 100Gi, 500Gi)"
        },
        "file_explorer_enabled": {
          "type": "boolean",
          "title": "File explorer",
          "default": true,
          "description": "A password-protected file manager for this app's own data on its own address: browse, download, upload, rename and delete files without needing a terminal. Folders holding a database server (Postgres, MariaDB, Redis, MongoDB, MinIO) always stay read-only."
        },
        "tor_enabled": {
          "type": "boolean",
          "title": "Tor",
          "default": false,
          "description": "Also reachable as a .onion address in Tor Browser, from any network and without IPv6. Slower than the normal address, and visitors never learn your home's IP address."
        },
        "tailscale_enabled": {
          "type": "boolean",
          "title": "Tailscale",
          "default": false,
          "description": "Also reachable from your own devices in your Tailscale network, at https://<name>.<your-tailnet>.ts.net, from any network and without IPv6. Turn on HTTPS certificates in the Tailscale admin console (DNS page) first."
        }
      },
      "dependencies": {
        "file_explorer_enabled": {
          "oneOf": [
            {
              "properties": {
                "file_explorer_enabled": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "file_explorer_enabled": {
                  "const": true
                },
                "file_explorer_subdomain": {
                  "type": "string",
                  "title": "File explorer subdomain",
                  "format": "tunnel",
                  "description": "Leave empty to use this app's subdomain followed by -files."
                },
                "file_explorer_username": {
                  "type": "string",
                  "title": "File explorer username",
                  "default": "admin",
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "file_explorer_password": {
                  "type": "string",
                  "title": "File explorer password",
                  "minLength": 12,
                  "writeOnly": true,
                  "generate": true
                },
                "file_explorer_read_only": {
                  "type": "boolean",
                  "title": "Read only",
                  "default": false,
                  "description": "Only browse and download. Nothing can be uploaded, renamed, edited or deleted through the file explorer."
                }
              }
            }
          ]
        },
        "tailscale_enabled": {
          "oneOf": [
            {
              "properties": {
                "tailscale_enabled": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "tailscale_enabled": {
                  "const": true
                },
                "tailscale_auth_key": {
                  "type": "string",
                  "title": "Tailscale auth key",
                  "writeOnly": true,
                  "pattern": "^tskey-",
                  "description": "Create one in the Tailscale admin console under Settings, Keys. It is used only the first time; after that the app stays signed in."
                },
                "tailscale_hostname": {
                  "type": "string",
                  "title": "Tailscale name",
                  "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
                  "description": "This app's device name in your tailnet. Leave empty to use its subdomain."
                }
              },
              "required": [
                "tailscale_auth_key"
              ]
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "url": {
          "type": "string",
          "title": "Web URL",
          "format": "uri",
          "source": {
            "logs": "YOLAB_OUTPUT url (\\S+)"
          }
        },
        "file_explorer_url": {
          "type": "string",
          "title": "File explorer",
          "format": "uri",
          "source": {
            "logs": "YOLAB_OUTPUT file_explorer_url (\\S+)"
          },
          "when": {
            "properties": {
              "file_explorer_enabled": {
                "const": true
              }
            }
          }
        },
        "file_explorer_username": {
          "type": "string",
          "title": "File explorer username",
          "source": {
            "logs": "YOLAB_OUTPUT file_explorer_username (\\S+)"
          },
          "when": {
            "properties": {
              "file_explorer_enabled": {
                "const": true
              }
            }
          }
        },
        "file_explorer_password": {
          "type": "string",
          "title": "File explorer password",
          "format": "secret",
          "source": {
            "logs": "YOLAB_OUTPUT file_explorer_password (\\S+)"
          },
          "when": {
            "properties": {
              "file_explorer_enabled": {
                "const": true
              }
            }
          }
        },
        "tor_url": {
          "type": "string",
          "title": "Tor address",
          "format": "uri",
          "source": {
            "logs": "YOLAB_OUTPUT tor_url (\\S+)"
          },
          "when": {
            "properties": {
              "tor_enabled": {
                "const": true
              }
            }
          }
        },
        "tailscale_url": {
          "type": "string",
          "title": "Tailscale address",
          "format": "uri",
          "source": {
            "logs": "YOLAB_OUTPUT tailscale_url (\\S+)"
          },
          "when": {
            "properties": {
              "tailscale_enabled": {
                "const": true
              }
            }
          }
        }
      }
    }
  }
}
