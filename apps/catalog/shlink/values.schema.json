{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Shlink",
      "type": "object",
      "required": [
        "api_key"
      ],
      "properties": {
        "yolab_enabled": {
          "type": "boolean",
          "title": "YoLab address",
          "default": true,
          "description": "Reachable from anywhere at https://<subdomain>.<your-number>.yolab.io, through your YoLab tunnel. Visitors need IPv6."
        },
        "api_key": {
          "type": "string",
          "title": "API key",
          "minLength": 16,
          "description": "Random string. Use it to authenticate with the Shlink REST API.",
          "writeOnly": true,
          "generate": true
        }
      },
      "dependencies": {
        "yolab_enabled": {
          "oneOf": [
            {
              "properties": {
                "yolab_enabled": {
                  "const": false
                }
              },
              "required": [
                "yolab_enabled"
              ]
            },
            {
              "properties": {
                "yolab_enabled": {
                  "const": true
                },
                "subdomain": {
                  "type": "string",
                  "title": "Subdomain",
                  "format": "tunnel",
                  "default": "shlink"
                },
                "yolab_token": {
                  "type": "string",
                  "title": "YoLab token",
                  "format": "yolab-token",
                  "writeOnly": true,
                  "description": "Leave it as it is to use this box's YoLab account."
                }
              },
              "required": [
                "subdomain"
              ]
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "url": {
          "type": "string",
          "title": "Web URL",
          "format": "uri"
        },
        "api_key": {
          "type": "string",
          "title": "API key",
          "format": "secret"
        }
      }
    }
  }
}
