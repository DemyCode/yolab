{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Syncthing",
      "type": "object",
      "required": [
        "subdomain"
      ],
      "properties": {
        "subdomain": {
          "type": "string",
          "title": "Subdomain",
          "format": "tunnel",
          "default": "syncthing"
        },
        "storage_size": {
          "type": "string",
          "title": "Storage size",
          "description": "Size of the persistent volume for synced files",
          "default": "20Gi",
          "enum": [
            "5Gi",
            "10Gi",
            "20Gi",
            "50Gi",
            "100Gi"
          ]
        }
      }
    },
    "yolab": {
      "type": "object",
      "description": "Injected by local-api at install time; not user-editable.",
      "properties": {
        "platformApiUrl": {
          "type": "string"
        },
        "accountToken": {
          "type": "string"
        },
        "serviceName": {
          "type": "string"
        },
        "images": {
          "type": "object"
        },
        "gateway": {
          "type": "object",
          "properties": {
            "upstream": {
              "type": "string"
            },
            "caddyfile": {
              "type": "string"
            },
            "pvcName": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
