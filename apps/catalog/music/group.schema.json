{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "config": {
      "title": "Music",
      "type": "object",
      "required": ["music_folder", "download_client"],
      "properties": {
        "music_folder": {
          "$ref": "chart:navidrome#/properties/config/properties/music_folder",
          "minLength": 1,
          "description": "One folder for your downloads and your albums, shared by every app here. Create one, or pick one you have."
        },
        "download_client": {
          "type": "string",
          "title": "Download client",
          "default": "qbittorrent",
          "oneOf": [
            { "const": "qbittorrent", "title": "Install qBittorrent" },
            { "const": "transmission", "title": "Install Transmission" },
            { "const": "existing", "title": "Use one I already have" },
            { "const": "none", "title": "No download client" }
          ]
        },
        "listen_anywhere": {
          "type": "boolean",
          "title": "Listen from anywhere",
          "default": true,
          "description": "Navidrome gets a YoLab address you can open from any network. Off, it is reachable at home only."
        },
        "tailscale": {
          "$ref": "chart:navidrome#/properties/config/properties/tailscale_enabled",
          "title": "Listen over Tailscale",
          "description": "Navidrome also joins your tailnet, so your own devices reach it privately."
        },
        "manage_anywhere": {
          "type": "boolean",
          "title": "Manage downloads from anywhere",
          "default": true,
          "description": "Lidarr and the download client get YoLab addresses too. Off, you manage them at home only."
        }
      },
      "dependencies": {
        "download_client": {
          "oneOf": [
            {
              "properties": {
                "download_client": { "enum": ["qbittorrent", "transmission", "none"] }
              }
            },
            {
              "properties": {
                "download_client": { "const": "existing" },
                "existing_client": {
                  "type": "string",
                  "title": "Which one",
                  "format": "app",
                  "x-yolab-charts": ["qbittorrent", "transmission"],
                  "description": "It joins this group as it is: point it at the music folder in its own settings."
                }
              },
              "required": ["existing_client"]
            }
          ]
        },
        "tailscale": {
          "oneOf": [
            { "properties": { "tailscale": { "const": false } } },
            {
              "properties": {
                "tailscale": { "const": true },
                "tailscale_auth_key": {
                  "$ref": "chart:navidrome#/properties/config/dependencies/tailscale_enabled/oneOf/1/properties/tailscale_auth_key"
                }
              },
              "required": ["tailscale_auth_key"]
            }
          ]
        }
      }
    }
  }
}
