{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Music",
      "type": "object",
      "required": [
        "subdomain"
      ],
      "properties": {
        "files_folder_existing": {
          "type": "boolean",
          "title": "Use an existing folder",
          "default": false,
          "description": "Off: a new folder, music, inside this service's own folder. On: pick a folder already in your file tree; every service set to the same folder sees the same files."
        },
        "subdomain": {
          "type": "string",
          "title": "Address",
          "format": "tunnel",
          "default": "music",
          "description": "Each app gets its own address under it: music-navidrome, music-lidarr, music-prowlarr and music-qbittorrent."
        },
        "download_client": {
          "type": "string",
          "title": "Download client",
          "default": "new",
          "oneOf": [
            {
              "const": "new",
              "title": "Install qBittorrent"
            },
            {
              "const": "existing",
              "title": "Use a qBittorrent I already have"
            }
          ]
        },
        "listen_anywhere": {
          "type": "boolean",
          "title": "Listen from anywhere",
          "default": true,
          "description": "Navidrome gets a YoLab address you can open from any network. Off, it is reachable at home only."
        },
        "manage_anywhere": {
          "type": "boolean",
          "title": "Manage downloads from anywhere",
          "default": true,
          "description": "Lidarr, Prowlarr and qBittorrent get YoLab addresses too. Off, you manage them at home only."
        }
      },
      "dependencies": {
        "files_folder_existing": {
          "oneOf": [
            {
              "properties": {
                "files_folder_existing": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "files_folder_existing": {
                  "const": true
                },
                "files_folder": {
                  "type": "string",
                  "title": "Files folder",
                  "format": "tree-folder",
                  "minLength": 1,
                  "pattern": "^/$|^$|^/?[A-Za-z0-9_ -][A-Za-z0-9._ -]*(/[A-Za-z0-9_ -][A-Za-z0-9._ -]*)*/?$",
                  "description": "Open a folder to see the folders inside it, then pick one. / is the whole file tree, every service's data included."
                }
              },
              "required": [
                "files_folder"
              ]
            }
          ]
        },
        "download_client": {
          "oneOf": [
            {
              "properties": {
                "download_client": {
                  "const": "new"
                },
                "vpn_enabled": {
                  "type": "boolean",
                  "title": "Download through Mullvad",
                  "default": false,
                  "description": "qBittorrent reaches the internet only through a Mullvad VPN, and stops downloading if the VPN is down."
                }
              },
              "dependencies": {
                "vpn_enabled": {
                  "oneOf": [
                    {
                      "properties": {
                        "vpn_enabled": {
                          "const": false
                        }
                      }
                    },
                    {
                      "properties": {
                        "vpn_enabled": {
                          "const": true
                        },
                        "vpn_private_key": {
                          "type": "string",
                          "title": "Mullvad WireGuard private key",
                          "minLength": 1,
                          "writeOnly": true,
                          "description": "From mullvad.net → Account → WireGuard configuration → generate a key, then copy the PrivateKey line."
                        },
                        "vpn_addresses": {
                          "type": "string",
                          "title": "Mullvad WireGuard address",
                          "minLength": 1,
                          "description": "The Address line from the same Mullvad configuration file, e.g. 10.64.123.45/32."
                        },
                        "vpn_server_countries": {
                          "type": "string",
                          "title": "VPN server countries",
                          "default": "",
                          "description": "Optional. Comma-separated, e.g. Netherlands,Switzerland. Empty lets the VPN pick."
                        }
                      },
                      "required": [
                        "vpn_private_key",
                        "vpn_addresses"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "properties": {
                "download_client": {
                  "const": "existing"
                },
                "existing_client": {
                  "type": "object",
                  "title": "Which qBittorrent",
                  "description": "Lidarr sends its downloads to it.",
                  "properties": {
                    "internal_url": {
                      "type": "string",
                      "title": "Address",
                      "format": "uri"
                    },
                    "username": {
                      "type": "string",
                      "title": "Username"
                    },
                    "password": {
                      "type": "string",
                      "title": "Password"
                    }
                  }
                }
              },
              "required": [
                "existing_client"
              ]
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "navidrome_url": {
          "type": "string",
          "title": "Navidrome",
          "format": "uri"
        },
        "lidarr_url": {
          "type": "string",
          "title": "Lidarr",
          "format": "uri"
        },
        "prowlarr_url": {
          "type": "string",
          "title": "Prowlarr",
          "format": "uri"
        },
        "qbittorrent_url": {
          "type": "string",
          "title": "qBittorrent",
          "format": "uri"
        },
        "qbittorrent_username": {
          "type": "string",
          "title": "qBittorrent username",
          "format": "text"
        },
        "qbittorrent_password": {
          "type": "string",
          "title": "qBittorrent password",
          "format": "secret"
        },
        "lidarr_api_key": {
          "type": "string",
          "title": "Lidarr API key",
          "format": "secret"
        },
        "prowlarr_api_key": {
          "type": "string",
          "title": "Prowlarr API key",
          "format": "secret"
        }
      }
    }
  }
}
