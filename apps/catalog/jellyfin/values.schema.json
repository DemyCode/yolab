{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Jellyfin",
      "type": "object",
      "properties": {
        "files_folder_existing": {
          "type": "boolean",
          "title": "Use an existing folder",
          "default": false,
          "description": "Off: the service gets a new folder of its own, named after it. On: pick a folder already in your file tree; every service set to the same folder sees the same files."
        },
        "yolab_enabled": {
          "type": "boolean",
          "title": "YoLab address",
          "default": true,
          "description": "Reachable from anywhere at https://<subdomain>.<your-number>.yolab.io, through your YoLab tunnel. Visitors need IPv6."
        },
        "hardware_transcoding": {
          "type": "boolean",
          "title": "Hardware transcoding",
          "default": true,
          "description": "Run Jellyfin on the machine with the best graphics card for video (Intel first, then NVIDIA, then AMD) so it can convert films for phones and browsers without straining the processor. Turn it on in Jellyfin too: Dashboard, Playback, Transcoding."
        },
        "admin_password": {
          "type": "string",
          "title": "Admin password",
          "writeOnly": true,
          "generate": true,
          "description": "The password of the user admin, set the first time Jellyfin starts so it is ready to use. Leave it empty to go through Jellyfin's own setup instead."
        },
        "libraries": {
          "type": "array",
          "title": "Libraries",
          "default": [
            {
              "name": "Films",
              "kind": "movies",
              "path": "movies"
            },
            {
              "name": "Shows",
              "kind": "tvshows",
              "path": "shows"
            }
          ],
          "description": "Libraries Jellyfin adds once it is set up, each a folder inside its files folder. The ones you add in Jellyfin yourself are left alone.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "kind",
              "path"
            ],
            "properties": {
              "name": {
                "type": "string",
                "title": "Name",
                "pattern": "^[A-Za-z0-9 ]+$"
              },
              "kind": {
                "type": "string",
                "title": "Kind",
                "default": "movies",
                "oneOf": [
                  {
                    "const": "movies",
                    "title": "Films"
                  },
                  {
                    "const": "tvshows",
                    "title": "Shows"
                  },
                  {
                    "const": "music",
                    "title": "Music"
                  },
                  {
                    "const": "books",
                    "title": "Books"
                  },
                  {
                    "const": "homevideos",
                    "title": "Home videos and photos"
                  }
                ]
              },
              "path": {
                "type": "string",
                "title": "Folder",
                "pattern": "^[A-Za-z0-9_ -][A-Za-z0-9._ -]*(/[A-Za-z0-9_ -][A-Za-z0-9._ -]*)*$"
              }
            }
          }
        },
        "tor_enabled": {
          "type": "boolean",
          "title": "Tor",
          "default": false,
          "description": "Also reachable as a .onion address in Tor Browser, from any network and without IPv6. Slower than the normal address, and visitors never learn your home's IP address."
        },
        "tailscale_enabled": {
          "type": "boolean",
          "title": "Tailscale",
          "default": false,
          "description": "Also reachable from your own devices in your Tailscale network, at https://<name>.<your-tailnet>.ts.net, from any network and without IPv6. Turn on HTTPS certificates in the Tailscale admin console (DNS page) first."
        }
      },
      "dependencies": {
        "files_folder_existing": {
          "oneOf": [
            {
              "properties": {
                "files_folder_existing": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "files_folder_existing": {
                  "const": true
                },
                "files_folder": {
                  "type": "string",
                  "title": "Files folder",
                  "format": "tree-folder",
                  "minLength": 1,
                  "pattern": "^/$|^$|^/?[A-Za-z0-9_ -][A-Za-z0-9._ -]*(/[A-Za-z0-9_ -][A-Za-z0-9._ -]*)*/?$",
                  "description": "Open a folder to see the folders inside it, then pick one. / is the whole file tree, every service's data included."
                }
              },
              "required": [
                "files_folder"
              ]
            }
          ]
        },
        "yolab_enabled": {
          "oneOf": [
            {
              "properties": {
                "yolab_enabled": {
                  "const": false
                }
              },
              "required": [
                "yolab_enabled"
              ]
            },
            {
              "properties": {
                "yolab_enabled": {
                  "const": true
                },
                "subdomain": {
                  "type": "string",
                  "title": "Subdomain",
                  "format": "tunnel",
                  "default": "jellyfin"
                },
                "yolab_token": {
                  "type": "string",
                  "title": "YoLab token",
                  "format": "yolab-token",
                  "writeOnly": true,
                  "description": "Leave it as it is to use this box's YoLab account."
                }
              },
              "required": [
                "subdomain"
              ]
            }
          ]
        },
        "tailscale_enabled": {
          "oneOf": [
            {
              "properties": {
                "tailscale_enabled": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "tailscale_enabled": {
                  "const": true
                },
                "tailscale_auth_key": {
                  "type": "string",
                  "title": "Tailscale auth key",
                  "writeOnly": true,
                  "pattern": "^tskey-",
                  "description": "Create one in the Tailscale admin console under Settings, Keys. It is used only the first time; after that the app stays signed in."
                },
                "tailscale_hostname": {
                  "type": "string",
                  "title": "Tailscale name",
                  "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
                  "description": "This app's device name in your tailnet. Leave empty to use its subdomain."
                }
              },
              "required": [
                "tailscale_auth_key"
              ]
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "username": {
          "type": "string",
          "title": "Username",
          "format": "text"
        },
        "password": {
          "type": "string",
          "title": "Password",
          "format": "secret"
        },
        "api_key": {
          "type": "string",
          "title": "API key",
          "format": "secret"
        },
        "url": {
          "type": "string",
          "title": "Web URL",
          "format": "uri"
        },
        "tor_url": {
          "type": "string",
          "title": "Tor address",
          "format": "uri"
        },
        "tailscale_url": {
          "type": "string",
          "title": "Tailscale address",
          "format": "uri"
        }
      }
    }
  }
}
