{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Prowlarr",
      "type": "object",
      "properties": {
        "yolab_enabled": {
          "type": "boolean",
          "title": "YoLab address",
          "default": true,
          "description": "Reachable from anywhere at https://<subdomain>.<your-number>.yolab.io, through your YoLab tunnel. Visitors need IPv6."
        },
        "api_key": {
          "type": "string",
          "title": "API key",
          "writeOnly": true,
          "generate": true,
          "pattern": "^([A-Za-z0-9]{20,})?$",
          "description": "What other apps use to talk to Prowlarr. Leave it as it is to keep the key Prowlarr has now."
        },
        "sonarr": {
          "type": "object",
          "title": "Sonarr",
          "description": "Prowlarr hands its indexers to this Sonarr and keeps them in sync.",
          "properties": {
            "internal_url": {
              "type": "string",
              "title": "Address",
              "format": "uri"
            },
            "api_key": {
              "type": "string",
              "title": "API key"
            }
          }
        },
        "radarr": {
          "type": "object",
          "title": "Radarr",
          "description": "Prowlarr hands its indexers to this Radarr and keeps them in sync.",
          "properties": {
            "internal_url": {
              "type": "string",
              "title": "Address",
              "format": "uri"
            },
            "api_key": {
              "type": "string",
              "title": "API key"
            }
          }
        },
        "lidarr": {
          "type": "object",
          "title": "Lidarr",
          "description": "Prowlarr hands its indexers to this Lidarr and keeps them in sync.",
          "properties": {
            "internal_url": {
              "type": "string",
              "title": "Address",
              "format": "uri"
            },
            "api_key": {
              "type": "string",
              "title": "API key"
            }
          }
        }
      },
      "dependencies": {
        "yolab_enabled": {
          "oneOf": [
            {
              "properties": {
                "yolab_enabled": {
                  "const": false
                }
              },
              "required": [
                "yolab_enabled"
              ]
            },
            {
              "properties": {
                "yolab_enabled": {
                  "const": true
                },
                "subdomain": {
                  "type": "string",
                  "title": "Subdomain",
                  "format": "tunnel",
                  "default": "prowlarr"
                },
                "yolab_token": {
                  "type": "string",
                  "title": "YoLab token",
                  "format": "yolab-token",
                  "writeOnly": true,
                  "description": "Leave it as it is to use this box's YoLab account."
                }
              },
              "required": [
                "subdomain"
              ]
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "api_key": {
          "type": "string",
          "title": "API key",
          "format": "secret"
        }
      }
    }
  }
}
