{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Media stack",
      "type": "object",
      "required": [
        "vpn_private_key",
        "vpn_addresses",
        "auth_mode"
      ],
      "properties": {
        "yolab_enabled": {
          "type": "boolean",
          "title": "YoLab address",
          "default": true,
          "description": "Reachable from anywhere at https://<subdomain>.<your-number>.yolab.io, through your YoLab tunnel. Visitors need IPv6."
        },
        "timezone": {
          "type": "string",
          "title": "Time zone",
          "default": "Etc/UTC",
          "description": "Used for schedules and log times, e.g. Europe/Paris."
        },
        "vpn_private_key": {
          "type": "string",
          "title": "Mullvad WireGuard private key",
          "minLength": 1,
          "writeOnly": true,
          "description": "From mullvad.net → Account → WireGuard configuration → generate a key, then copy the PrivateKey line. qBittorrent, the indexers and the downloaders only reach the internet through this VPN and stop if it is down."
        },
        "vpn_addresses": {
          "type": "string",
          "title": "Mullvad WireGuard address",
          "minLength": 1,
          "description": "The Address line from the same Mullvad configuration file, e.g. 10.64.123.45/32."
        },
        "vpn_server_countries": {
          "type": "string",
          "title": "VPN server countries",
          "default": "",
          "description": "Optional. Comma-separated, e.g. Netherlands,Switzerland. Empty lets the VPN pick."
        },
        "auth_mode": {
          "type": "string",
          "title": "Sign-in",
          "default": "own",
          "oneOf": [
            {
              "const": "own",
              "title": "Its own login, with the users below"
            },
            {
              "const": "existing",
              "title": "An Authelia you already run, with its users"
            }
          ]
        }
      },
      "dependencies": {
        "yolab_enabled": {
          "oneOf": [
            {
              "properties": {
                "yolab_enabled": {
                  "const": false
                }
              },
              "required": [
                "yolab_enabled"
              ]
            },
            {
              "properties": {
                "yolab_enabled": {
                  "const": true
                },
                "subdomain": {
                  "type": "string",
                  "title": "Subdomain",
                  "format": "tunnel",
                  "default": "media",
                  "description": "Jellyfin lives here. Every other tool gets its own address starting with this name: media-requests, media-sonarr, media-radarr, media-lidarr, media-prowlarr, media-bazarr, media-books, media-torrents and media-cleanuparr."
                },
                "yolab_token": {
                  "type": "string",
                  "title": "YoLab token",
                  "format": "yolab-token",
                  "writeOnly": true,
                  "description": "Leave it as it is to use this box's YoLab account."
                }
              },
              "required": [
                "subdomain"
              ]
            }
          ]
        },
        "auth_mode": {
          "oneOf": [
            {
              "properties": {
                "auth_mode": {
                  "const": "own"
                },
                "auth_users": {
                  "type": "array",
                  "title": "Logins for the admin tools",
                  "description": "Sonarr, Radarr, Lidarr, Prowlarr, Bazarr, LazyLibrarian, qBittorrent and Cleanuparr sit behind this one login. Jellyfin and the request page keep their own accounts so TV and phone apps work.",
                  "minItems": 1,
                  "default": [],
                  "items": {
                    "type": "object",
                    "required": [
                      "username",
                      "password"
                    ],
                    "properties": {
                      "username": {
                        "type": "string",
                        "title": "Username",
                        "minLength": 1
                      },
                      "password": {
                        "type": "string",
                        "title": "Password",
                        "minLength": 8,
                        "writeOnly": true,
                        "generate": true
                      }
                    }
                  }
                }
              },
              "required": [
                "auth_users"
              ]
            },
            {
              "properties": {
                "auth_mode": {
                  "const": "existing"
                },
                "auth_url": {
                  "type": "string",
                  "title": "Authelia address",
                  "format": "uri",
                  "description": "Where this service asks who is signed in. For the Authelia service of this box, copy its \"Address for your other services\" output. People then sign in once, on that Authelia's page, for all your services that use it."
                }
              },
              "required": [
                "auth_url"
              ]
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "url": {
          "type": "string",
          "title": "Jellyfin",
          "format": "uri"
        },
        "requests_url": {
          "type": "string",
          "title": "Requests (Seerr)",
          "format": "uri"
        },
        "sonarr_url": {
          "type": "string",
          "title": "Sonarr (TV)",
          "format": "uri"
        },
        "radarr_url": {
          "type": "string",
          "title": "Radarr (films)",
          "format": "uri"
        },
        "lidarr_url": {
          "type": "string",
          "title": "Lidarr (music)",
          "format": "uri"
        },
        "books_url": {
          "type": "string",
          "title": "LazyLibrarian (books)",
          "format": "uri"
        },
        "prowlarr_url": {
          "type": "string",
          "title": "Prowlarr (indexers)",
          "format": "uri"
        },
        "bazarr_url": {
          "type": "string",
          "title": "Bazarr (subtitles)",
          "format": "uri"
        },
        "cleanuparr_url": {
          "type": "string",
          "title": "Cleanuparr",
          "format": "uri"
        },
        "torrents_url": {
          "type": "string",
          "title": "qBittorrent",
          "format": "uri"
        },
        "torrents_username": {
          "type": "string",
          "title": "qBittorrent username",
          "format": "text"
        },
        "torrents_password": {
          "type": "string",
          "title": "qBittorrent temporary password",
          "format": "secret"
        },
        "wiring": {
          "type": "string",
          "title": "Connecting the tools",
          "format": "text"
        }
      }
    }
  }
}
