{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "File Browser",
      "type": "object",
      "required": [
        "password"
      ],
      "properties": {
        "yolab_enabled": {
          "type": "boolean",
          "title": "YoLab address",
          "default": true,
          "description": "Reachable from anywhere at https://<subdomain>.<your-number>.yolab.io, through your YoLab tunnel. Visitors need IPv6."
        },
        "password": {
          "type": "string",
          "title": "Admin password",
          "description": "At least 12 characters. You sign in as admin with this.",
          "minLength": 12,
          "writeOnly": true,
          "generate": true
        },
        "storage_size": {
          "type": "string",
          "title": "Storage size",
          "default": "50Gi",
          "description": "How much CephFS storage to allocate (e.g. 20Gi, 100Gi, 500Gi)"
        }
      },
      "dependencies": {
        "yolab_enabled": {
          "oneOf": [
            {
              "properties": {
                "yolab_enabled": {
                  "const": false
                }
              },
              "required": [
                "yolab_enabled"
              ]
            },
            {
              "properties": {
                "yolab_enabled": {
                  "const": true
                },
                "subdomain": {
                  "type": "string",
                  "title": "Subdomain",
                  "format": "tunnel",
                  "default": "filebrowser"
                },
                "yolab_token": {
                  "type": "string",
                  "title": "YoLab token",
                  "format": "yolab-token",
                  "writeOnly": true,
                  "description": "Leave it as it is to use this box's YoLab account."
                }
              },
              "required": [
                "subdomain"
              ]
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "url": {
          "type": "string",
          "title": "Web URL",
          "format": "uri",
          "source": {
            "logs": "YOLAB_OUTPUT url (\\S+)"
          },
          "when": {
            "properties": {
              "yolab_enabled": {
                "const": true
              }
            }
          }
        },
        "password": {
          "type": "string",
          "title": "Admin password",
          "format": "secret",
          "source": {
            "config": "password"
          }
        }
      }
    }
  }
}
