{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "File Browser",
      "type": "object",
      "required": [
        "password"
      ],
      "properties": {
        "yolab_enabled": {
          "type": "boolean",
          "title": "YoLab address",
          "default": true,
          "description": "Reachable from anywhere at https://<subdomain>.<your-number>.yolab.io, through your YoLab tunnel. Visitors need IPv6."
        },
        "password": {
          "type": "string",
          "title": "Admin password",
          "description": "At least 12 characters. You sign in as admin with this.",
          "minLength": 12,
          "writeOnly": true,
          "generate": true
        },
        "storage_size": {
          "type": "string",
          "title": "Storage size",
          "default": "50Gi",
          "description": "How much CephFS storage to allocate (e.g. 20Gi, 100Gi, 500Gi)"
        },
        "tor_enabled": {
          "type": "boolean",
          "title": "Tor",
          "default": false,
          "description": "Also reachable as a .onion address in Tor Browser, from any network and without IPv6. Slower than the normal address, and visitors never learn your home's IP address."
        },
        "tailscale_enabled": {
          "type": "boolean",
          "title": "Tailscale",
          "default": false,
          "description": "Also reachable from your own devices in your Tailscale network, at https://<name>.<your-tailnet>.ts.net, from any network and without IPv6. Turn on HTTPS certificates in the Tailscale admin console (DNS page) first."
        }
      },
      "dependencies": {
        "yolab_enabled": {
          "oneOf": [
            {
              "properties": {
                "yolab_enabled": {
                  "const": false
                }
              },
              "required": [
                "yolab_enabled"
              ]
            },
            {
              "properties": {
                "yolab_enabled": {
                  "const": true
                },
                "subdomain": {
                  "type": "string",
                  "title": "Subdomain",
                  "format": "tunnel",
                  "default": "filebrowser"
                },
                "yolab_token": {
                  "type": "string",
                  "title": "YoLab token",
                  "format": "yolab-token",
                  "writeOnly": true,
                  "description": "Leave it as it is to use this box's YoLab account."
                }
              },
              "required": [
                "subdomain"
              ]
            }
          ]
        },
        "tailscale_enabled": {
          "oneOf": [
            {
              "properties": {
                "tailscale_enabled": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "tailscale_enabled": {
                  "const": true
                },
                "tailscale_auth_key": {
                  "type": "string",
                  "title": "Tailscale auth key",
                  "writeOnly": true,
                  "pattern": "^tskey-",
                  "description": "Create one in the Tailscale admin console under Settings, Keys. It is used only the first time; after that the app stays signed in."
                },
                "tailscale_hostname": {
                  "type": "string",
                  "title": "Tailscale name",
                  "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
                  "description": "This app's device name in your tailnet. Leave empty to use its subdomain."
                }
              },
              "required": [
                "tailscale_auth_key"
              ]
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "url": {
          "type": "string",
          "title": "Web URL",
          "format": "uri",
          "source": {
            "logs": "YOLAB_OUTPUT url (\\S+)"
          },
          "when": {
            "properties": {
              "yolab_enabled": {
                "const": true
              }
            }
          }
        },
        "password": {
          "type": "string",
          "title": "Admin password",
          "format": "secret",
          "source": {
            "config": "password"
          }
        },
        "tor_url": {
          "type": "string",
          "title": "Tor address",
          "format": "uri",
          "source": {
            "logs": "YOLAB_OUTPUT tor_url (\\S+)"
          },
          "when": {
            "properties": {
              "tor_enabled": {
                "const": true
              }
            }
          }
        },
        "tailscale_url": {
          "type": "string",
          "title": "Tailscale address",
          "format": "uri",
          "source": {
            "logs": "YOLAB_OUTPUT tailscale_url (\\S+)"
          },
          "when": {
            "properties": {
              "tailscale_enabled": {
                "const": true
              }
            }
          }
        }
      }
    }
  }
}
