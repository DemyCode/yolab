{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["config"],
  "properties": {
    "config": {
      "title": "Speedtest Tracker",
      "type": "object",
      "required": ["subdomain"],
      "properties": {
        "subdomain": { "type": "string", "title": "Subdomain", "format": "tunnel", "default": "speedtest" },
        "schedule": {
          "type": "string",
          "title": "How often to test",
          "default": "0 * * * *",
          "description": "Cron format. \"0 * * * *\" is every hour; \"0 */6 * * *\" is every six."
        },
        "storage_size": { "type": "string", "title": "Storage size", "default": "2Gi" }
      }
    },
    "yolab": {
      "type": "object",
      "description": "Injected by local-api at install time; not user-editable.",
      "properties": {
        "platformApiUrl": { "type": "string" },
        "accountToken": { "type": "string" },
        "serviceName": { "type": "string" },
        "images": { "type": "object" },
        "gateway": {
          "type": "object",
          "properties": {
            "upstream": { "type": "string" },
            "caddyfile": { "type": "string" },
            "pvcName": { "type": "string" }
          }
        }
      }
    }
  }
}
