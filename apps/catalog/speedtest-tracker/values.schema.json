{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Speedtest Tracker",
      "type": "object",
      "required": [
        "admin_password"
      ],
      "properties": {
        "yolab_enabled": {
          "type": "boolean",
          "title": "YoLab address",
          "default": true,
          "description": "Reachable from anywhere at https://<subdomain>.<your-number>.yolab.io, through your YoLab tunnel. Visitors need IPv6."
        },
        "schedule": {
          "type": "string",
          "title": "How often to test",
          "default": "0 * * * *",
          "description": "Cron format. \"0 * * * *\" is every hour; \"0 */6 * * *\" is every six."
        },
        "admin_email": {
          "type": "string",
          "title": "Admin email",
          "format": "email",
          "default": "admin@example.com"
        },
        "admin_password": {
          "type": "string",
          "title": "Admin password",
          "minLength": 10,
          "writeOnly": true,
          "generate": true
        }
      },
      "dependencies": {
        "yolab_enabled": {
          "oneOf": [
            {
              "properties": {
                "yolab_enabled": {
                  "const": false
                }
              },
              "required": [
                "yolab_enabled"
              ]
            },
            {
              "properties": {
                "yolab_enabled": {
                  "const": true
                },
                "subdomain": {
                  "type": "string",
                  "title": "Subdomain",
                  "format": "tunnel",
                  "default": "speedtest"
                },
                "yolab_token": {
                  "type": "string",
                  "title": "YoLab token",
                  "format": "yolab-token",
                  "writeOnly": true,
                  "description": "Leave it as it is to use this box's YoLab account."
                }
              },
              "required": [
                "subdomain"
              ]
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "admin_password": {
          "type": "string",
          "title": "Admin password",
          "format": "secret"
        }
      }
    }
  }
}
