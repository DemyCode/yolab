{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "SplitPro",
      "type": "object",
      "properties": {
        "yolab_enabled": {
          "type": "boolean",
          "title": "YoLab address",
          "default": true,
          "description": "Reachable from anywhere at https://<subdomain>.<your-number>.yolab.io, through your YoLab tunnel. Visitors need IPv6."
        },
        "sign_in": {
          "type": "string",
          "title": "Sign-in",
          "default": "oidc",
          "description": "SplitPro has no passwords. People sign in through an identity provider such as Authelia, Authentik or Keycloak, or with a one-time link sent by email.",
          "oneOf": [
            {
              "const": "oidc",
              "title": "Identity provider (OIDC)"
            },
            {
              "const": "email",
              "title": "Email link (needs an SMTP server)"
            }
          ]
        },
        "app_secret": {
          "type": "string",
          "title": "Session secret",
          "description": "Signs the sign-in sessions.",
          "writeOnly": true,
          "generate": true,
          "minLength": 32
        }
      },
      "dependencies": {
        "sign_in": {
          "oneOf": [
            {
              "properties": {
                "sign_in": {
                  "const": "oidc"
                },
                "oidc_name": {
                  "type": "string",
                  "title": "Provider name",
                  "default": "Authelia",
                  "description": "Shown on the sign-in button."
                },
                "oidc_well_known_url": {
                  "type": "string",
                  "title": "Discovery URL",
                  "format": "uri",
                  "description": "The provider's .well-known/openid-configuration address, e.g. https://auth.example.com/.well-known/openid-configuration. At the provider, set the redirect URL to this app's address followed by /api/auth/callback/ and the provider name in lower case."
                },
                "oidc_client_id": {
                  "type": "string",
                  "title": "Client ID",
                  "default": "splitpro"
                },
                "oidc_client_secret": {
                  "type": "string",
                  "title": "Client secret",
                  "writeOnly": true
                }
              },
              "required": [
                "oidc_well_known_url",
                "oidc_client_id",
                "oidc_client_secret"
              ]
            },
            {
              "properties": {
                "sign_in": {
                  "const": "email"
                },
                "from_email": {
                  "type": "string",
                  "title": "Sender address",
                  "format": "email"
                },
                "email_server_host": {
                  "type": "string",
                  "title": "SMTP server",
                  "description": "e.g. smtp.example.com"
                },
                "email_server_port": {
                  "type": "string",
                  "title": "SMTP port",
                  "default": "587",
                  "pattern": "^[0-9]+$"
                },
                "email_server_user": {
                  "type": "string",
                  "title": "SMTP username"
                },
                "email_server_password": {
                  "type": "string",
                  "title": "SMTP password",
                  "writeOnly": true
                }
              },
              "required": [
                "from_email",
                "email_server_host",
                "email_server_port"
              ]
            }
          ]
        },
        "yolab_enabled": {
          "oneOf": [
            {
              "properties": {
                "yolab_enabled": {
                  "const": false
                }
              },
              "required": [
                "yolab_enabled"
              ]
            },
            {
              "properties": {
                "yolab_enabled": {
                  "const": true
                },
                "subdomain": {
                  "type": "string",
                  "title": "Subdomain",
                  "format": "tunnel",
                  "default": "splitpro"
                },
                "yolab_token": {
                  "type": "string",
                  "title": "YoLab token",
                  "format": "yolab-token",
                  "writeOnly": true,
                  "description": "Leave it as it is to use this box's YoLab account."
                }
              },
              "required": [
                "subdomain"
              ]
            }
          ]
        }
      },
      "required": [
        "app_secret",
        "sign_in"
      ]
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "url": {
          "type": "string",
          "title": "Web URL",
          "format": "uri"
        }
      }
    }
  }
}
