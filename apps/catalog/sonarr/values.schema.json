{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Sonarr",
      "type": "object",
      "properties": {
        "files_folder": {
          "type": "string",
          "title": "Files folder",
          "default": "",
          "pattern": "^$|^/?[A-Za-z0-9_ -][A-Za-z0-9._ -]*(/[A-Za-z0-9_ -][A-Za-z0-9._ -]*)*/?$",
          "description": "Where in your file tree this service keeps its files. Leave it empty for a folder named after the service. Set another service to the same folder and both see the same files."
        },
        "shows_path": {
          "type": "string",
          "title": "Shows folder",
          "default": "shows",
          "pattern": "^[A-Za-z0-9_ -][A-Za-z0-9._ -]*(/[A-Za-z0-9_ -][A-Za-z0-9._ -]*)*$",
          "description": "Where Sonarr keeps your shows, inside its files folder."
        },
        "yolab_enabled": {
          "type": "boolean",
          "title": "YoLab address",
          "default": true,
          "description": "Reachable from anywhere at https://<subdomain>.<your-number>.yolab.io, through your YoLab tunnel. Visitors need IPv6."
        },
        "api_key": {
          "type": "string",
          "title": "API key",
          "writeOnly": true,
          "generate": true,
          "pattern": "^([A-Za-z0-9]{20,})?$",
          "description": "What other apps use to talk to Sonarr. Leave it as it is to keep the key Sonarr has now."
        },
        "download_client": {
          "type": "object",
          "title": "Download client",
          "description": "The qBittorrent Sonarr sends episodes to. Sonarr keeps one download client called \"qBittorrent (YoLab)\" set to it and leaves the ones you add yourself alone.",
          "properties": {
            "internal_url": {
              "type": "string",
              "title": "Address",
              "format": "uri"
            },
            "username": {
              "type": "string",
              "title": "Username"
            },
            "password": {
              "type": "string",
              "title": "Password"
            }
          }
        }
      },
      "dependencies": {
        "yolab_enabled": {
          "oneOf": [
            {
              "properties": {
                "yolab_enabled": {
                  "const": false
                }
              },
              "required": [
                "yolab_enabled"
              ]
            },
            {
              "properties": {
                "yolab_enabled": {
                  "const": true
                },
                "subdomain": {
                  "type": "string",
                  "title": "Subdomain",
                  "format": "tunnel",
                  "default": "sonarr"
                },
                "yolab_token": {
                  "type": "string",
                  "title": "YoLab token",
                  "format": "yolab-token",
                  "writeOnly": true,
                  "description": "Leave it as it is to use this box's YoLab account."
                }
              },
              "required": [
                "subdomain"
              ]
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "api_key": {
          "type": "string",
          "title": "API key",
          "format": "secret"
        }
      }
    }
  }
}
