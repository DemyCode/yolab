{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Sonarr",
      "type": "object",
      "required": [
        "subdomain"
      ],
      "properties": {
        "subdomain": {
          "type": "string",
          "title": "Subdomain",
          "format": "tunnel",
          "default": "sonarr"
        },
        "storage_size": {
          "type": "string",
          "title": "Storage size",
          "default": "50Gi"
        },
        "file_explorer_enabled": {
          "type": "boolean",
          "title": "File explorer",
          "default": true,
          "description": "A lightweight, password-protected, read-only browser for this app's own data — handy for pulling a file out or checking what's actually stored, without needing a terminal. The password is generated for you and shown once the app finishes starting."
        }
      }
    },
    "yolab": {
      "type": "object",
      "description": "Injected by local-api at install time; not user-editable.",
      "properties": {
        "platformApiUrl": {
          "type": "string"
        },
        "accountToken": {
          "type": "string"
        },
        "serviceName": {
          "type": "string"
        },
        "images": {
          "type": "object"
        },
        "gateway": {
          "type": "object",
          "properties": {
            "upstream": {
              "type": "string"
            },
            "caddyfile": {
              "type": "string"
            },
            "pvcName": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
