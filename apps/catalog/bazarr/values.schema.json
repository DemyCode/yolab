{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Bazarr",
      "type": "object",
      "properties": {
        "files_folder_existing": {
          "type": "boolean",
          "title": "Use an existing folder",
          "default": false,
          "description": "Off: a new folder, media, inside this service's own folder. On: pick a folder already in your file tree; every service set to the same folder sees the same files."
        },
        "yolab_enabled": {
          "type": "boolean",
          "title": "YoLab address",
          "default": true,
          "description": "Reachable from anywhere at https://<subdomain>.<your-number>.yolab.io, through your YoLab tunnel. Visitors need IPv6."
        },
        "subtitle_languages": {
          "type": "array",
          "title": "Subtitle languages",
          "default": [
            "en"
          ],
          "description": "Two-letter codes, e.g. en, fr, de. Bazarr starts with a profile looking for these on every show and film; once it has profiles, change them in Bazarr itself.",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          }
        },
        "sonarr": {
          "type": "object",
          "title": "Sonarr",
          "description": "Bazarr finds subtitles for the shows this Sonarr manages.",
          "properties": {
            "internal_url": {
              "type": "string",
              "title": "Address",
              "format": "uri"
            },
            "api_key": {
              "type": "string",
              "title": "API key"
            }
          }
        },
        "radarr": {
          "type": "object",
          "title": "Radarr",
          "description": "Bazarr finds subtitles for the films this Radarr manages.",
          "properties": {
            "internal_url": {
              "type": "string",
              "title": "Address",
              "format": "uri"
            },
            "api_key": {
              "type": "string",
              "title": "API key"
            }
          }
        }
      },
      "dependencies": {
        "files_folder_existing": {
          "oneOf": [
            {
              "properties": {
                "files_folder_existing": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "files_folder_existing": {
                  "const": true
                },
                "files_folder": {
                  "type": "string",
                  "title": "Files folder",
                  "format": "tree-folder",
                  "minLength": 1,
                  "pattern": "^/$|^$|^/?[A-Za-z0-9_ -][A-Za-z0-9._ -]*(/[A-Za-z0-9_ -][A-Za-z0-9._ -]*)*/?$",
                  "description": "Open a folder to see the folders inside it, then pick one. / is the whole file tree, every service's data included."
                }
              },
              "required": [
                "files_folder"
              ]
            }
          ]
        },
        "yolab_enabled": {
          "oneOf": [
            {
              "properties": {
                "yolab_enabled": {
                  "const": false
                }
              },
              "required": [
                "yolab_enabled"
              ]
            },
            {
              "properties": {
                "yolab_enabled": {
                  "const": true
                },
                "subdomain": {
                  "type": "string",
                  "title": "Subdomain",
                  "format": "tunnel",
                  "default": "bazarr"
                },
                "yolab_token": {
                  "type": "string",
                  "title": "YoLab token",
                  "format": "yolab-token",
                  "writeOnly": true,
                  "description": "Leave it as it is to use this box's YoLab account."
                }
              },
              "required": [
                "subdomain"
              ]
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "api_key": {
          "type": "string",
          "title": "API key",
          "format": "secret"
        },
        "url": {
          "type": "string",
          "title": "Web URL",
          "format": "uri"
        }
      }
    }
  }
}
