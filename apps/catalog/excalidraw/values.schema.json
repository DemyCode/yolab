{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Excalidraw",
      "type": "object",
      "properties": {
        "yolab_enabled": {
          "type": "boolean",
          "title": "YoLab address",
          "default": true,
          "description": "Reachable from anywhere at https://<subdomain>.<your-number>.yolab.io, through your YoLab tunnel. Visitors need IPv6."
        },
        "auth_enabled": {
          "type": "boolean",
          "title": "Add login",
          "default": false,
          "description": "Excalidraw has no login of its own. Turn this on to put a username and password in front of it."
        }
      },
      "dependencies": {
        "yolab_enabled": {
          "oneOf": [
            {
              "properties": {
                "yolab_enabled": {
                  "const": false
                }
              },
              "required": [
                "yolab_enabled"
              ]
            },
            {
              "properties": {
                "yolab_enabled": {
                  "const": true
                },
                "subdomain": {
                  "type": "string",
                  "title": "Subdomain",
                  "format": "tunnel",
                  "default": "excalidraw"
                },
                "yolab_token": {
                  "type": "string",
                  "title": "YoLab token",
                  "format": "yolab-token",
                  "writeOnly": true,
                  "description": "Leave it as it is to use this box's YoLab account."
                }
              },
              "required": [
                "subdomain"
              ]
            }
          ]
        },
        "auth_enabled": {
          "oneOf": [
            {
              "properties": {
                "auth_enabled": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "auth_enabled": {
                  "const": true
                },
                "auth_mode": {
                  "type": "string",
                  "title": "Sign-in",
                  "default": "own",
                  "oneOf": [
                    {
                      "const": "own",
                      "title": "Its own login, with the users below"
                    },
                    {
                      "const": "existing",
                      "title": "An Authelia you already run, with its users"
                    }
                  ]
                }
              },
              "required": [
                "auth_mode"
              ],
              "dependencies": {
                "auth_mode": {
                  "oneOf": [
                    {
                      "properties": {
                        "auth_mode": {
                          "const": "own"
                        },
                        "auth_users": {
                          "type": "array",
                          "title": "Logins",
                          "description": "Who can open this app. Each person gets their own username and password.",
                          "default": [],
                          "items": {
                            "type": "object",
                            "required": [
                              "username",
                              "password"
                            ],
                            "properties": {
                              "username": {
                                "type": "string",
                                "title": "Username",
                                "minLength": 1
                              },
                              "password": {
                                "type": "string",
                                "title": "Password",
                                "minLength": 8,
                                "writeOnly": true,
                                "generate": true
                              }
                            }
                          }
                        }
                      },
                      "required": [
                        "auth_users"
                      ]
                    },
                    {
                      "properties": {
                        "auth_mode": {
                          "const": "existing"
                        },
                        "auth_url": {
                          "type": "string",
                          "title": "Authelia address",
                          "format": "uri",
                          "description": "Where this service asks who is signed in. For the Authelia service of this box, copy its \"Address for your other services\" output. People then sign in once, on that Authelia's page, for all your services that use it."
                        }
                      },
                      "required": [
                        "auth_url"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "url": {
          "type": "string",
          "title": "Web URL",
          "format": "uri"
        }
      }
    }
  }
}
