{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Excalidraw",
      "type": "object",
      "required": [
        "subdomain"
      ],
      "properties": {
        "subdomain": {
          "type": "string",
          "title": "Subdomain",
          "format": "tunnel",
          "default": "excalidraw"
        },
        "storage_size": {
          "type": "string",
          "title": "Storage size",
          "default": "1Gi",
          "description": "How much CephFS storage to allocate (e.g. 20Gi, 100Gi, 500Gi)"
        },
        "auth_enabled": {
          "type": "boolean",
          "title": "Add login",
          "default": false,
          "description": "Excalidraw has no login of its own. Turn this on to put a username and password in front of it."
        },
        "file_explorer_enabled": {
          "type": "boolean",
          "title": "File explorer",
          "default": true,
          "description": "A lightweight, password-protected, read-only browser for this app's own data on its own address — handy for pulling a file out or checking what's actually stored, without needing a terminal."
        }
      },
      "dependencies": {
        "auth_enabled": {
          "oneOf": [
            {
              "properties": {
                "auth_enabled": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "auth_enabled": {
                  "const": true
                },
                "auth_users": {
                  "type": "array",
                  "title": "Logins",
                  "description": "Who can open this app. Each person gets their own username and password.",
                  "default": [],
                  "items": {
                    "type": "object",
                    "required": [
                      "username",
                      "password"
                    ],
                    "properties": {
                      "username": {
                        "type": "string",
                        "title": "Username",
                        "minLength": 1
                      },
                      "password": {
                        "type": "string",
                        "title": "Password",
                        "minLength": 8,
                        "writeOnly": true,
                        "generate": true
                      }
                    }
                  }
                }
              },
              "required": [
                "auth_users"
              ]
            }
          ]
        },
        "file_explorer_enabled": {
          "oneOf": [
            {
              "properties": {
                "file_explorer_enabled": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "file_explorer_enabled": {
                  "const": true
                },
                "file_explorer_subdomain": {
                  "type": "string",
                  "title": "File explorer subdomain",
                  "format": "tunnel",
                  "description": "Leave empty to use this app's subdomain followed by -files."
                },
                "file_explorer_username": {
                  "type": "string",
                  "title": "File explorer username",
                  "default": "admin",
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "file_explorer_password": {
                  "type": "string",
                  "title": "File explorer password",
                  "minLength": 12,
                  "writeOnly": true,
                  "generate": true
                }
              }
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "url": {
          "type": "string",
          "title": "Web URL",
          "format": "uri",
          "source": {
            "logs": "YOLAB_OUTPUT url (\\S+)"
          }
        },
        "file_explorer_url": {
          "type": "string",
          "title": "File explorer",
          "format": "uri",
          "source": {
            "logs": "YOLAB_OUTPUT file_explorer_url (\\S+)"
          },
          "when": {
            "properties": {
              "file_explorer_enabled": {
                "const": true
              }
            }
          }
        },
        "file_explorer_username": {
          "type": "string",
          "title": "File explorer username",
          "source": {
            "logs": "YOLAB_OUTPUT file_explorer_username (\\S+)"
          },
          "when": {
            "properties": {
              "file_explorer_enabled": {
                "const": true
              }
            }
          }
        },
        "file_explorer_password": {
          "type": "string",
          "title": "File explorer password",
          "format": "secret",
          "source": {
            "logs": "YOLAB_OUTPUT file_explorer_password (\\S+)"
          },
          "when": {
            "properties": {
              "file_explorer_enabled": {
                "const": true
              }
            }
          }
        }
      }
    }
  }
}
