{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Excalidraw",
      "type": "object",
      "required": [
        "subdomain"
      ],
      "properties": {
        "subdomain": {
          "type": "string",
          "title": "Subdomain",
          "format": "tunnel",
          "default": "excalidraw"
        },
        "storage_size": {
          "type": "string",
          "title": "Storage size",
          "default": "1Gi",
          "description": "How much CephFS storage to allocate (e.g. 20Gi, 100Gi, 500Gi)"
        },
        "auth_enabled": {
          "type": "boolean",
          "title": "Add login",
          "default": false,
          "description": "Excalidraw has no login of its own. Turn this on to put a username and password in front of it."
        },
        "auth_users": {
          "type": "array",
          "title": "Logins",
          "description": "Who can open this app. Each person gets their own username and password.",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "username",
              "password"
            ],
            "properties": {
              "username": {
                "type": "string",
                "title": "Username",
                "minLength": 1
              },
              "password": {
                "type": "string",
                "title": "Password",
                "minLength": 8
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "auth_enabled": {
                "const": true
              }
            },
            "required": [
              "auth_enabled"
            ]
          },
          "then": {
            "required": [
              "auth_users"
            ]
          },
          "else": {
            "properties": {
              "auth_users": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "yolab": {
      "type": "object",
      "description": "Injected by local-api at install time; not user-editable.",
      "properties": {
        "platformApiUrl": {
          "type": "string"
        },
        "accountToken": {
          "type": "string"
        },
        "serviceName": {
          "type": "string"
        },
        "images": {
          "type": "object"
        },
        "gateway": {
          "type": "object",
          "properties": {
            "upstream": {
              "type": "string"
            },
            "caddyfile": {
              "type": "string"
            },
            "pvcName": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
