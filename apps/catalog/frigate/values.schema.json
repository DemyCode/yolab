{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["config"],
  "properties": {
    "config": {
      "title": "Frigate",
      "type": "object",
      "required": ["subdomain"],
      "properties": {
        "subdomain": {
          "type": "string",
          "title": "Subdomain",
          "format": "tunnel",
          "default": "frigate"
        },
        "storage_size": {
          "type": "string",
          "title": "Storage size",
          "default": "100Gi",
          "description": "Camera recordings add up fast — how much CephFS storage to allocate (e.g. 100Gi, 500Gi, 2Ti)"
        }
      }
    },
    "yolab": {
      "type": "object",
      "description": "Injected by local-api at install time; not user-editable.",
      "properties": {
        "platformApiUrl": { "type": "string" },
        "accountToken": { "type": "string" },
        "serviceName": { "type": "string" },
        "images": { "type": "object" },
        "gateway": {
          "type": "object",
          "properties": {
            "upstream": { "type": "string" },
            "caddyfile": { "type": "string" },
            "pvcName": { "type": "string" }
          }
        }
      }
    }
  }
}
