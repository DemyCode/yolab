{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["config"],
  "properties": {
    "config": {
      "title": "RomM",
      "type": "object",
      "required": ["subdomain", "auth_secret_key"],
      "properties": {
        "subdomain": {
          "type": "string",
          "title": "Subdomain",
          "format": "tunnel",
          "default": "romm"
        },
        "auth_secret_key": {
          "type": "string",
          "title": "Auth secret key",
          "minLength": 32,
          "description": "Used to sign session cookies."
        },
        "storage_size": {
          "type": "string",
          "title": "Storage size",
          "default": "50Gi",
          "description": "How much CephFS storage to allocate for your ROM library (e.g. 50Gi, 200Gi, 1Ti)"
        }
      }
    },
    "yolab": {
      "type": "object",
      "description": "Injected by local-api at install time; not user-editable.",
      "properties": {
        "platformApiUrl": { "type": "string" },
        "accountToken": { "type": "string" },
        "serviceName": { "type": "string" },
        "images": { "type": "object" },
        "gateway": {
          "type": "object",
          "properties": {
            "upstream": { "type": "string" },
            "caddyfile": { "type": "string" },
            "pvcName": { "type": "string" }
          }
        }
      }
    }
  }
}
