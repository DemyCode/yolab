{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "SearXNG",
      "type": "object",
      "required": [
        "subdomain"
      ],
      "properties": {
        "subdomain": {
          "type": "string",
          "title": "Subdomain",
          "format": "tunnel",
          "default": "searxng"
        },
        "storage_size": {
          "type": "string",
          "title": "Storage size",
          "default": "1Gi",
          "description": "How much CephFS storage to allocate (e.g. 20Gi, 100Gi, 500Gi)"
        },
        "file_explorer_enabled": {
          "type": "boolean",
          "title": "File explorer",
          "default": true,
          "description": "A password-protected file manager for this app's own data on its own address: browse, download, upload, rename and delete files without needing a terminal. Folders holding a database server (Postgres, MariaDB, Redis, MongoDB, MinIO) always stay read-only."
        }
      },
      "dependencies": {
        "file_explorer_enabled": {
          "oneOf": [
            {
              "properties": {
                "file_explorer_enabled": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "file_explorer_enabled": {
                  "const": true
                },
                "file_explorer_subdomain": {
                  "type": "string",
                  "title": "File explorer subdomain",
                  "format": "tunnel",
                  "description": "Leave empty to use this app's subdomain followed by -files."
                },
                "file_explorer_username": {
                  "type": "string",
                  "title": "File explorer username",
                  "default": "admin",
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "file_explorer_password": {
                  "type": "string",
                  "title": "File explorer password",
                  "minLength": 12,
                  "writeOnly": true,
                  "generate": true
                },
                "file_explorer_read_only": {
                  "type": "boolean",
                  "title": "Read only",
                  "default": false,
                  "description": "Only browse and download. Nothing can be uploaded, renamed, edited or deleted through the file explorer."
                }
              }
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "url": {
          "type": "string",
          "title": "Web URL",
          "format": "uri",
          "source": {
            "logs": "YOLAB_OUTPUT url (\\S+)"
          }
        },
        "file_explorer_url": {
          "type": "string",
          "title": "File explorer",
          "format": "uri",
          "source": {
            "logs": "YOLAB_OUTPUT file_explorer_url (\\S+)"
          },
          "when": {
            "properties": {
              "file_explorer_enabled": {
                "const": true
              }
            }
          }
        },
        "file_explorer_username": {
          "type": "string",
          "title": "File explorer username",
          "source": {
            "logs": "YOLAB_OUTPUT file_explorer_username (\\S+)"
          },
          "when": {
            "properties": {
              "file_explorer_enabled": {
                "const": true
              }
            }
          }
        },
        "file_explorer_password": {
          "type": "string",
          "title": "File explorer password",
          "format": "secret",
          "source": {
            "logs": "YOLAB_OUTPUT file_explorer_password (\\S+)"
          },
          "when": {
            "properties": {
              "file_explorer_enabled": {
                "const": true
              }
            }
          }
        }
      }
    }
  }
}
