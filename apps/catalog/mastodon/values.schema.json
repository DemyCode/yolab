{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Mastodon",
      "type": "object",
      "required": [
        "subdomain",
        "owner_username",
        "owner_email"
      ],
      "properties": {
        "subdomain": {
          "type": "string",
          "title": "Subdomain",
          "format": "tunnel",
          "default": "mastodon",
          "description": "This becomes your server's permanent address and part of every username on it. Mastodon cannot change it later without breaking every follow — pick the one you want to keep."
        },
        "owner_username": {
          "type": "string",
          "title": "Your username",
          "default": "admin",
          "pattern": "^[a-zA-Z0-9_]{1,30}$",
          "description": "Letters, numbers and underscores. This account is created for you and owns the server."
        },
        "owner_email": {
          "type": "string",
          "title": "Your email",
          "format": "email",
          "default": "",
          "description": "Used to sign in and for admin notices. The account is created already confirmed, so no email needs to arrive for you to log in."
        },
        "smtp_server": {
          "type": "string",
          "title": "Email server (optional)",
          "default": "",
          "description": "Leave empty to run this as a one-person server. Anyone else signing up needs a confirmation email, which needs this filled in. e.g. smtp.fastmail.com"
        },
        "smtp_port": {
          "type": "integer",
          "title": "Email server port",
          "default": 587,
          "minimum": 1,
          "maximum": 65535
        },
        "smtp_login": {
          "type": "string",
          "title": "Email username",
          "default": ""
        },
        "smtp_password": {
          "type": "string",
          "title": "Email password",
          "default": "",
          "writeOnly": true
        },
        "smtp_from_address": {
          "type": "string",
          "title": "Send email from",
          "default": "",
          "description": "The address invitations and confirmations appear to come from. Defaults to your email above."
        },
        "storage_size": {
          "type": "string",
          "title": "Storage size",
          "default": "30Gi",
          "description": "Mastodon caches media from every account your users follow, so this fills faster than you would expect."
        },
        "file_explorer_enabled": {
          "type": "boolean",
          "title": "File explorer",
          "default": true,
          "description": "A password-protected file manager for this app's own data on its own address: browse, download, upload, rename and delete files without needing a terminal. Folders holding a database server (Postgres, MariaDB, Redis, MongoDB, MinIO) always stay read-only."
        }
      },
      "dependencies": {
        "file_explorer_enabled": {
          "oneOf": [
            {
              "properties": {
                "file_explorer_enabled": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "file_explorer_enabled": {
                  "const": true
                },
                "file_explorer_subdomain": {
                  "type": "string",
                  "title": "File explorer subdomain",
                  "format": "tunnel",
                  "description": "Leave empty to use this app's subdomain followed by -files."
                },
                "file_explorer_username": {
                  "type": "string",
                  "title": "File explorer username",
                  "default": "admin",
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "file_explorer_password": {
                  "type": "string",
                  "title": "File explorer password",
                  "minLength": 12,
                  "writeOnly": true,
                  "generate": true
                },
                "file_explorer_read_only": {
                  "type": "boolean",
                  "title": "Read only",
                  "default": false,
                  "description": "Only browse and download. Nothing can be uploaded, renamed, edited or deleted through the file explorer."
                }
              }
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "owner_user": {
          "type": "string",
          "title": "Owner username",
          "format": "text",
          "source": {
            "logs": "YOLAB_OUTPUT owner_user (\\S+)"
          }
        },
        "owner_password": {
          "type": "string",
          "title": "Owner password",
          "format": "secret",
          "source": {
            "logs": "YOLAB_OUTPUT owner_password (\\S+)"
          }
        },
        "file_explorer_url": {
          "type": "string",
          "title": "File explorer",
          "format": "uri",
          "source": {
            "logs": "YOLAB_OUTPUT file_explorer_url (\\S+)"
          },
          "when": {
            "properties": {
              "file_explorer_enabled": {
                "const": true
              }
            }
          }
        },
        "file_explorer_username": {
          "type": "string",
          "title": "File explorer username",
          "source": {
            "logs": "YOLAB_OUTPUT file_explorer_username (\\S+)"
          },
          "when": {
            "properties": {
              "file_explorer_enabled": {
                "const": true
              }
            }
          }
        },
        "file_explorer_password": {
          "type": "string",
          "title": "File explorer password",
          "format": "secret",
          "source": {
            "logs": "YOLAB_OUTPUT file_explorer_password (\\S+)"
          },
          "when": {
            "properties": {
              "file_explorer_enabled": {
                "const": true
              }
            }
          }
        }
      }
    }
  }
}
