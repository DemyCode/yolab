{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Planka",
      "type": "object",
      "required": [
        "app_secret",
        "admin_password"
      ],
      "properties": {
        "yolab_enabled": {
          "type": "boolean",
          "title": "YoLab address",
          "default": true,
          "description": "Reachable from anywhere at https://<subdomain>.<your-number>.yolab.io, through your YoLab tunnel. Visitors need IPv6."
        },
        "admin_email": {
          "type": "string",
          "title": "Admin email",
          "format": "email",
          "default": "admin@example.com"
        },
        "admin_user": {
          "type": "string",
          "title": "Admin username",
          "default": "admin"
        },
        "admin_password": {
          "type": "string",
          "title": "Admin password",
          "minLength": 10,
          "writeOnly": true,
          "generate": true
        },
        "app_secret": {
          "type": "string",
          "title": "Secret key",
          "minLength": 16,
          "description": "Random string used to sign sessions.",
          "writeOnly": true,
          "generate": true
        }
      },
      "dependencies": {
        "yolab_enabled": {
          "oneOf": [
            {
              "properties": {
                "yolab_enabled": {
                  "const": false
                }
              },
              "required": [
                "yolab_enabled"
              ]
            },
            {
              "properties": {
                "yolab_enabled": {
                  "const": true
                },
                "subdomain": {
                  "type": "string",
                  "title": "Subdomain",
                  "format": "tunnel",
                  "default": "planka"
                },
                "yolab_token": {
                  "type": "string",
                  "title": "YoLab token",
                  "format": "yolab-token",
                  "writeOnly": true,
                  "description": "Leave it as it is to use this box's YoLab account."
                }
              },
              "required": [
                "subdomain"
              ]
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "url": {
          "type": "string",
          "title": "Web URL",
          "format": "uri"
        },
        "admin_password": {
          "type": "string",
          "title": "Admin password",
          "format": "secret"
        },
        "app_secret": {
          "type": "string",
          "title": "Secret key",
          "format": "secret"
        }
      }
    }
  }
}
