{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "BookStack",
      "type": "object",
      "required": [
        "subdomain",
        "app_key"
      ],
      "properties": {
        "subdomain": {
          "type": "string",
          "title": "Subdomain",
          "format": "tunnel",
          "default": "bookstack"
        },
        "app_key": {
          "type": "string",
          "title": "Encryption key",
          "minLength": 32,
          "description": "Random string, at least 32 characters. Changing it invalidates stored sessions."
        },
        "storage_size": {
          "type": "string",
          "title": "Storage size",
          "default": "20Gi",
          "description": "How much CephFS storage to allocate (e.g. 20Gi, 100Gi, 500Gi)"
        }
      }
    },
    "yolab": {
      "type": "object",
      "description": "Injected by local-api at install time; not user-editable.",
      "properties": {
        "platformApiUrl": {
          "type": "string"
        },
        "accountToken": {
          "type": "string"
        },
        "serviceName": {
          "type": "string"
        },
        "images": {
          "type": "object"
        },
        "gateway": {
          "type": "object",
          "properties": {
            "upstream": {
              "type": "string"
            },
            "caddyfile": {
              "type": "string"
            },
            "pvcName": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
