{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["config"],
  "properties": {
    "config": {
      "title": "Monica",
      "type": "object",
      "required": ["subdomain", "app_key"],
      "properties": {
        "subdomain": {
          "type": "string",
          "title": "Subdomain",
          "format": "tunnel",
          "default": "monica"
        },
        "app_key": {
          "type": "string",
          "title": "Encryption key",
          "minLength": 32,
          "maxLength": 32,
          "description": "Exactly 32 random characters. Monica refuses to start otherwise."
        },
        "storage_size": {
          "type": "string",
          "title": "Storage size",
          "default": "5Gi",
          "description": "How much CephFS storage to allocate (e.g. 5Gi, 20Gi)"
        }
      }
    },
    "yolab": {
      "type": "object",
      "description": "Injected by local-api at install time; not user-editable.",
      "properties": {
        "platformApiUrl": { "type": "string" },
        "accountToken": { "type": "string" },
        "serviceName": { "type": "string" },
        "images": { "type": "object" },
        "gateway": {
          "type": "object",
          "properties": {
            "upstream": { "type": "string" },
            "caddyfile": { "type": "string" },
            "pvcName": { "type": "string" }
          }
        }
      }
    }
  }
}
