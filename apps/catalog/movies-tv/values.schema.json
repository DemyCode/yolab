{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Movies & TV",
      "type": "object",
      "required": [
        "media_folder",
        "subdomain"
      ],
      "properties": {
        "media_folder": {
          "type": "string",
          "title": "Media folder",
          "format": "folder",
          "default": "",
          "minLength": 1,
          "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?)?$",
          "description": "One folder for downloads and the library, at /data/<folder> in every app: qBittorrent downloads into downloads/, Sonarr moves shows into tv/ and Radarr films into movies/, and Jellyfin plays them. It stays when you uninstall."
        },
        "subdomain": {
          "type": "string",
          "title": "Address",
          "format": "tunnel",
          "default": "media",
          "description": "Each app gets its own address under it: media-jellyfin, media-sonarr, media-radarr, media-prowlarr and media-qbittorrent."
        },
        "download_client": {
          "type": "string",
          "title": "Download client",
          "default": "new",
          "oneOf": [
            { "const": "new", "title": "Install qBittorrent" },
            { "const": "existing", "title": "Use a qBittorrent I already have" }
          ]
        },
        "requests": {
          "type": "boolean",
          "title": "Requests with Seerr",
          "default": true,
          "description": "The people you share Jellyfin with sign in to Seerr with their Jellyfin account and ask for films and shows; Radarr and Sonarr fetch them."
        },
        "subtitles": {
          "type": "boolean",
          "title": "Subtitles with Bazarr",
          "default": true,
          "description": "Finds subtitles for everything Sonarr and Radarr bring in."
        },
        "hardware_transcoding": {
          "type": "boolean",
          "title": "Hardware transcoding",
          "default": true,
          "description": "Run Jellyfin on the machine with the best graphics card for video."
        },
        "watch_anywhere": {
          "type": "boolean",
          "title": "Watch from anywhere",
          "default": true,
          "description": "Jellyfin gets a YoLab address you can open from any network. Off, it is reachable at home only."
        },
        "manage_anywhere": {
          "type": "boolean",
          "title": "Manage downloads from anywhere",
          "default": true,
          "description": "Sonarr, Radarr, Prowlarr and qBittorrent get YoLab addresses too. Off, you manage them at home only."
        }
      },
      "dependencies": {
        "subtitles": {
          "oneOf": [
            {
              "properties": {
                "subtitles": { "const": false }
              }
            },
            {
              "properties": {
                "subtitles": { "const": true },
                "subtitle_languages": {
                  "type": "array",
                  "title": "Subtitle languages",
                  "default": ["en"],
                  "description": "Two-letter codes, e.g. en, fr, de.",
                  "items": { "type": "string", "pattern": "^[a-z]{2}$" }
                }
              }
            }
          ]
        },
        "download_client": {
          "oneOf": [
            {
              "properties": {
                "download_client": { "const": "new" },
                "vpn_enabled": {
                  "type": "boolean",
                  "title": "Download through Mullvad",
                  "default": false,
                  "description": "qBittorrent reaches the internet only through a Mullvad VPN, and stops downloading if the VPN is down."
                }
              },
              "dependencies": {
                "vpn_enabled": {
                  "oneOf": [
                    {
                      "properties": {
                        "vpn_enabled": { "const": false }
                      }
                    },
                    {
                      "properties": {
                        "vpn_enabled": { "const": true },
                        "vpn_private_key": {
                          "type": "string",
                          "title": "Mullvad WireGuard private key",
                          "minLength": 1,
                          "writeOnly": true,
                          "description": "From mullvad.net → Account → WireGuard configuration → generate a key, then copy the PrivateKey line."
                        },
                        "vpn_addresses": {
                          "type": "string",
                          "title": "Mullvad WireGuard address",
                          "minLength": 1,
                          "description": "The Address line from the same Mullvad configuration file, e.g. 10.64.123.45/32."
                        },
                        "vpn_server_countries": {
                          "type": "string",
                          "title": "VPN server countries",
                          "default": "",
                          "description": "Optional. Comma-separated, e.g. Netherlands,Switzerland. Empty lets the VPN pick."
                        }
                      },
                      "required": ["vpn_private_key", "vpn_addresses"]
                    }
                  ]
                }
              }
            },
            {
              "properties": {
                "download_client": { "const": "existing" },
                "existing_client": {
                  "type": "object",
                  "title": "Which qBittorrent",
                  "description": "Sonarr and Radarr send their downloads to it. Point it at the same media folder in its own settings.",
                  "properties": {
                    "internal_url": { "type": "string", "title": "Address", "format": "uri" },
                    "username": { "type": "string", "title": "Username" },
                    "password": { "type": "string", "title": "Password" }
                  }
                }
              },
              "required": [
                "existing_client"
              ]
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "jellyfin_url": {
          "type": "string",
          "title": "Jellyfin",
          "format": "uri",
          "source": { "logs": "YOLAB_OUTPUT jellyfin_url (\\S+)" },
          "when": { "properties": { "watch_anywhere": { "const": true } } }
        },
        "sonarr_url": {
          "type": "string",
          "title": "Sonarr",
          "format": "uri",
          "source": { "logs": "YOLAB_OUTPUT sonarr_url (\\S+)" },
          "when": { "properties": { "manage_anywhere": { "const": true } } }
        },
        "radarr_url": {
          "type": "string",
          "title": "Radarr",
          "format": "uri",
          "source": { "logs": "YOLAB_OUTPUT radarr_url (\\S+)" },
          "when": { "properties": { "manage_anywhere": { "const": true } } }
        },
        "prowlarr_url": {
          "type": "string",
          "title": "Prowlarr",
          "format": "uri",
          "source": { "logs": "YOLAB_OUTPUT prowlarr_url (\\S+)" },
          "when": { "properties": { "manage_anywhere": { "const": true } } }
        },
        "qbittorrent_url": {
          "type": "string",
          "title": "qBittorrent",
          "format": "uri",
          "source": { "logs": "YOLAB_OUTPUT qbittorrent_url (\\S+)" },
          "when": {
            "properties": {
              "manage_anywhere": { "const": true },
              "download_client": { "const": "new" }
            }
          }
        },
        "qbittorrent_username": {
          "type": "string",
          "title": "qBittorrent username",
          "format": "text",
          "source": { "logs": "YOLAB_OUTPUT qbittorrent_username (\\S+)" },
          "when": { "properties": { "download_client": { "const": "new" } } }
        },
        "qbittorrent_password": {
          "type": "string",
          "title": "qBittorrent password",
          "format": "secret",
          "source": { "logs": "YOLAB_OUTPUT qbittorrent_password (\\S+)" },
          "when": { "properties": { "download_client": { "const": "new" } } }
        },
        "jellyfin_username": {
          "type": "string",
          "title": "Jellyfin username",
          "format": "text",
          "source": { "logs": "YOLAB_OUTPUT jellyfin_username (\\S+)" }
        },
        "jellyfin_password": {
          "type": "string",
          "title": "Jellyfin password",
          "format": "secret",
          "source": { "logs": "YOLAB_OUTPUT jellyfin_password (\\S+)" }
        },
        "jellyfin_api_key": {
          "type": "string",
          "title": "Jellyfin API key",
          "format": "secret",
          "source": { "logs": "YOLAB_OUTPUT jellyfin_api_key (\\S+)" }
        },
        "jellyseerr_url": {
          "type": "string",
          "title": "Seerr",
          "format": "uri",
          "source": { "logs": "YOLAB_OUTPUT jellyseerr_url (\\S+)" },
          "when": {
            "properties": {
              "watch_anywhere": { "const": true },
              "requests": { "const": true }
            }
          }
        },
        "jellyseerr_api_key": {
          "type": "string",
          "title": "Seerr API key",
          "format": "secret",
          "source": { "logs": "YOLAB_OUTPUT jellyseerr_api_key (\\S+)" },
          "when": { "properties": { "requests": { "const": true } } }
        },
        "bazarr_url": {
          "type": "string",
          "title": "Bazarr",
          "format": "uri",
          "source": { "logs": "YOLAB_OUTPUT bazarr_url (\\S+)" },
          "when": {
            "properties": {
              "manage_anywhere": { "const": true },
              "subtitles": { "const": true }
            }
          }
        },
        "bazarr_api_key": {
          "type": "string",
          "title": "Bazarr API key",
          "format": "secret",
          "source": { "logs": "YOLAB_OUTPUT bazarr_api_key (\\S+)" },
          "when": { "properties": { "subtitles": { "const": true } } }
        },
        "sonarr_api_key": {
          "type": "string",
          "title": "Sonarr API key",
          "format": "secret",
          "source": { "logs": "YOLAB_OUTPUT sonarr_api_key (\\S+)" }
        },
        "radarr_api_key": {
          "type": "string",
          "title": "Radarr API key",
          "format": "secret",
          "source": { "logs": "YOLAB_OUTPUT radarr_api_key (\\S+)" }
        },
        "prowlarr_api_key": {
          "type": "string",
          "title": "Prowlarr API key",
          "format": "secret",
          "source": { "logs": "YOLAB_OUTPUT prowlarr_api_key (\\S+)" }
        }
      }
    }
  }
}
