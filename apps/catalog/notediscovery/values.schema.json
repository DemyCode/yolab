{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "NoteDiscovery",
      "type": "object",
      "properties": {
        "files_folder": {
          "type": "string",
          "title": "Files folder",
          "default": "",
          "pattern": "^$|^/?[A-Za-z0-9_ -][A-Za-z0-9._ -]*(/[A-Za-z0-9_ -][A-Za-z0-9._ -]*)*/?$",
          "description": "Where in your file tree this service keeps its files. Leave it empty for a folder named after the service. Set another service to the same folder and both see the same files."
        },
        "password": {
          "type": "string",
          "title": "Password",
          "minLength": 12,
          "writeOnly": true,
          "generate": true,
          "description": "The password to sign in to NoteDiscovery. At least 12 characters."
        },
        "notes_path": {
          "type": "string",
          "title": "Notes folder",
          "default": "notes",
          "pattern": "^[A-Za-z0-9_ -][A-Za-z0-9._ -]*(/[A-Za-z0-9_ -][A-Za-z0-9._ -]*)*$",
          "description": "Where your notes are kept, as plain Markdown files, inside its files folder."
        },
        "yolab_enabled": {
          "type": "boolean",
          "title": "YoLab address",
          "default": true,
          "description": "Reachable from anywhere at https://<subdomain>.<your-number>.yolab.io, through your YoLab tunnel. Visitors need IPv6."
        }
      },
      "dependencies": {
        "yolab_enabled": {
          "oneOf": [
            {
              "properties": {
                "yolab_enabled": {
                  "const": false
                }
              },
              "required": [
                "yolab_enabled"
              ]
            },
            {
              "properties": {
                "yolab_enabled": {
                  "const": true
                },
                "subdomain": {
                  "type": "string",
                  "title": "Subdomain",
                  "format": "tunnel",
                  "default": "notediscovery"
                },
                "yolab_token": {
                  "type": "string",
                  "title": "YoLab token",
                  "format": "yolab-token",
                  "writeOnly": true,
                  "description": "Leave it as it is to use this box's YoLab account."
                }
              },
              "required": [
                "subdomain"
              ]
            }
          ]
        }
      },
      "required": [
        "password"
      ]
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "url": {
          "type": "string",
          "title": "Web URL",
          "format": "uri"
        },
        "password": {
          "type": "string",
          "title": "Password",
          "format": "secret"
        }
      }
    }
  }
}
