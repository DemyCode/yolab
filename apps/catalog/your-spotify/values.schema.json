{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Your Spotify",
      "type": "object",
      "required": [
        "spotify_public",
        "spotify_secret"
      ],
      "properties": {
        "yolab_enabled": {
          "type": "boolean",
          "title": "YoLab address",
          "default": true,
          "description": "Reachable from anywhere at https://<subdomain>.<your-number>.yolab.io, through your YoLab tunnel. Visitors need IPv6."
        },
        "spotify_public": {
          "type": "string",
          "title": "Spotify Client ID",
          "default": "",
          "description": "From developer.spotify.com/dashboard — create an app, then copy its Client ID here. Spotify will not let this read your history without one."
        },
        "spotify_secret": {
          "type": "string",
          "title": "Spotify Client Secret",
          "default": "",
          "description": "From the same page as the Client ID.",
          "writeOnly": true
        }
      },
      "dependencies": {
        "yolab_enabled": {
          "oneOf": [
            {
              "properties": {
                "yolab_enabled": {
                  "const": false
                }
              },
              "required": [
                "yolab_enabled"
              ]
            },
            {
              "properties": {
                "yolab_enabled": {
                  "const": true
                },
                "subdomain": {
                  "type": "string",
                  "title": "Subdomain",
                  "format": "tunnel",
                  "default": "spotify-stats"
                },
                "yolab_token": {
                  "type": "string",
                  "title": "YoLab token",
                  "format": "yolab-token",
                  "writeOnly": true,
                  "description": "Leave it as it is to use this box's YoLab account."
                }
              },
              "required": [
                "subdomain"
              ]
            }
          ]
        }
      }
    }
  }
}
