{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["config"],
  "properties": {
    "config": {
      "title": "Your Spotify",
      "type": "object",
      "required": ["subdomain", "spotify_public", "spotify_secret"],
      "properties": {
        "subdomain": { "type": "string", "title": "Subdomain", "format": "tunnel", "default": "spotify-stats" },
        "spotify_public": {
          "type": "string",
          "title": "Spotify Client ID",
          "default": "",
          "description": "From developer.spotify.com/dashboard — create an app, then copy its Client ID here. Spotify will not let this read your history without one."
        },
        "spotify_secret": {
          "type": "string",
          "title": "Spotify Client Secret",
          "default": "",
          "description": "From the same page as the Client ID."
        },
        "storage_size": { "type": "string", "title": "Storage size", "default": "5Gi" }
      }
    },
    "yolab": {
      "type": "object",
      "description": "Injected by local-api at install time; not user-editable.",
      "properties": {
        "platformApiUrl": { "type": "string" },
        "accountToken": { "type": "string" },
        "serviceName": { "type": "string" },
        "images": { "type": "object" },
        "gateway": { "type": "object", "properties": { "upstream": { "type": "string" }, "caddyfile": { "type": "string" }, "pvcName": { "type": "string" } } }
      }
    }
  }
}
