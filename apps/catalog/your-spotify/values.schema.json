{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Your Spotify",
      "type": "object",
      "required": [
        "subdomain",
        "spotify_public",
        "spotify_secret"
      ],
      "properties": {
        "subdomain": {
          "type": "string",
          "title": "Subdomain",
          "format": "tunnel",
          "default": "spotify-stats"
        },
        "spotify_public": {
          "type": "string",
          "title": "Spotify Client ID",
          "default": "",
          "description": "From developer.spotify.com/dashboard — create an app, then copy its Client ID here. Spotify will not let this read your history without one."
        },
        "spotify_secret": {
          "type": "string",
          "title": "Spotify Client Secret",
          "default": "",
          "description": "From the same page as the Client ID.",
          "writeOnly": true
        },
        "storage_size": {
          "type": "string",
          "title": "Storage size",
          "default": "5Gi"
        },
        "file_explorer_enabled": {
          "type": "boolean",
          "title": "File explorer",
          "default": true,
          "description": "A lightweight, password-protected, read-only browser for this app's own data — handy for pulling a file out or checking what's actually stored, without needing a terminal. The password is generated for you and shown once the app finishes starting."
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "file_explorer_url": {
          "type": "string",
          "title": "File explorer",
          "format": "uri",
          "source": {
            "logs": "YOLAB_OUTPUT file_explorer_url (\\S+)"
          },
          "when": {
            "properties": {
              "file_explorer_enabled": {
                "const": true
              }
            }
          }
        },
        "file_explorer_password": {
          "type": "string",
          "title": "File explorer password",
          "format": "secret",
          "source": {
            "logs": "YOLAB_OUTPUT file_explorer_password (\\S+)"
          },
          "when": {
            "properties": {
              "file_explorer_enabled": {
                "const": true
              }
            }
          }
        }
      }
    }
  }
}
