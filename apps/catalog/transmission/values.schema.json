{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Transmission",
      "type": "object",
      "properties": {
        "files_folder_existing": {
          "type": "boolean",
          "title": "Use an existing folder",
          "default": false,
          "description": "Off: a new folder, downloads, inside this service's own folder. On: pick a folder already in your file tree; every service set to the same folder sees the same files."
        },
        "downloads_path": {
          "type": "string",
          "title": "Downloads folder",
          "default": "downloads",
          "pattern": "^[A-Za-z0-9_ -][A-Za-z0-9._ -]*(/[A-Za-z0-9_ -][A-Za-z0-9._ -]*)*$",
          "description": "Where finished downloads go, inside its files folder."
        },
        "yolab_enabled": {
          "type": "boolean",
          "title": "YoLab address",
          "default": true,
          "description": "Reachable from anywhere at https://<subdomain>.<your-number>.yolab.io, through your YoLab tunnel. Visitors need IPv6."
        }
      },
      "dependencies": {
        "files_folder_existing": {
          "oneOf": [
            {
              "properties": {
                "files_folder_existing": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "files_folder_existing": {
                  "const": true
                },
                "files_folder": {
                  "type": "string",
                  "title": "Files folder",
                  "format": "tree-folder",
                  "minLength": 1,
                  "pattern": "^/$|^$|^/?[A-Za-z0-9_ -][A-Za-z0-9._ -]*(/[A-Za-z0-9_ -][A-Za-z0-9._ -]*)*/?$",
                  "description": "Open a folder to see the folders inside it, then pick one. / is the whole file tree, every service's data included."
                }
              },
              "required": [
                "files_folder"
              ]
            }
          ]
        },
        "yolab_enabled": {
          "oneOf": [
            {
              "properties": {
                "yolab_enabled": {
                  "const": false
                }
              },
              "required": [
                "yolab_enabled"
              ]
            },
            {
              "properties": {
                "yolab_enabled": {
                  "const": true
                },
                "subdomain": {
                  "type": "string",
                  "title": "Subdomain",
                  "format": "tunnel",
                  "default": "transmission"
                },
                "yolab_token": {
                  "type": "string",
                  "title": "YoLab token",
                  "format": "yolab-token",
                  "writeOnly": true,
                  "description": "Leave it as it is to use this box's YoLab account."
                },
                "auth_mode": {
                  "type": "string",
                  "title": "Login",
                  "default": "existing",
                  "description": "Transmission has no login of its own, so Authelia asks who you are before anyone reaches it on the YoLab address.",
                  "oneOf": [
                    {
                      "const": "existing",
                      "title": "The Authelia service you already run, with its users"
                    },
                    {
                      "const": "own",
                      "title": "Its own Authelia, with the users below"
                    }
                  ]
                }
              },
              "required": [
                "subdomain",
                "auth_mode"
              ],
              "dependencies": {
                "auth_mode": {
                  "oneOf": [
                    {
                      "properties": {
                        "auth_mode": {
                          "const": "own"
                        },
                        "auth_users": {
                          "type": "array",
                          "title": "Logins",
                          "description": "Who can open it. Each person gets their own username and password.",
                          "default": [],
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "required": [
                              "username",
                              "password"
                            ],
                            "properties": {
                              "username": {
                                "type": "string",
                                "title": "Username",
                                "pattern": "^[a-z0-9][a-z0-9._-]*$"
                              },
                              "password": {
                                "type": "string",
                                "title": "Password",
                                "minLength": 8,
                                "writeOnly": true,
                                "generate": true
                              }
                            }
                          }
                        }
                      },
                      "required": [
                        "auth_users"
                      ]
                    },
                    {
                      "properties": {
                        "auth_mode": {
                          "const": "existing"
                        },
                        "auth_url": {
                          "type": "string",
                          "title": "Authelia address",
                          "format": "uri",
                          "description": "Copy the Authelia service's \"Address for your other services\" output. People then sign in once, on that Authelia's page, for all your services that use it."
                        }
                      },
                      "required": [
                        "auth_url"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "url": {
          "type": "string",
          "title": "Web URL",
          "format": "uri"
        }
      }
    }
  }
}
