{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["config"],
  "properties": {
    "config": {
      "title": "Healthchecks",
      "type": "object",
      "required": ["subdomain", "admin_email", "admin_password"],
      "properties": {
        "subdomain": { "type": "string", "title": "Subdomain", "format": "tunnel", "default": "healthchecks" },
        "admin_email": {
          "type": "string",
          "title": "Your email",
          "format": "email",
          "default": "",
          "description": "You sign in with this. It is also where alerts are sent when a job stops reporting."
        },
        "admin_password": {
          "type": "string",
          "title": "Password",
          "minLength": 8,
          "default": "",
          "description": "At least 8 characters."
        },
        "storage_size": { "type": "string", "title": "Storage size", "default": "2Gi" }
      }
    },
    "yolab": {
      "type": "object",
      "description": "Injected by local-api at install time; not user-editable.",
      "properties": {
        "platformApiUrl": { "type": "string" },
        "accountToken": { "type": "string" },
        "serviceName": { "type": "string" },
        "images": { "type": "object" },
        "gateway": {
          "type": "object",
          "properties": {
            "upstream": { "type": "string" },
            "caddyfile": { "type": "string" },
            "pvcName": { "type": "string" }
          }
        }
      }
    }
  }
}
