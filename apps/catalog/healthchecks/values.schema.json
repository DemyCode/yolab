{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Healthchecks",
      "type": "object",
      "required": [
        "subdomain",
        "admin_email",
        "admin_password"
      ],
      "properties": {
        "subdomain": {
          "type": "string",
          "title": "Subdomain",
          "format": "tunnel",
          "default": "healthchecks"
        },
        "admin_email": {
          "type": "string",
          "title": "Your email",
          "format": "email",
          "default": "",
          "description": "You sign in with this. It is also where alerts are sent when a job stops reporting."
        },
        "admin_password": {
          "type": "string",
          "title": "Password",
          "minLength": 8,
          "default": "",
          "description": "At least 8 characters.",
          "writeOnly": true
        },
        "storage_size": {
          "type": "string",
          "title": "Storage size",
          "default": "2Gi"
        },
        "file_explorer_enabled": {
          "type": "boolean",
          "title": "File explorer",
          "default": true,
          "description": "A lightweight, password-protected, read-only browser for this app's own data — handy for pulling a file out or checking what's actually stored, without needing a terminal. The password is generated for you and shown once the app finishes starting."
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "file_explorer_url": {
          "type": "string",
          "title": "File explorer",
          "format": "uri",
          "source": {
            "logs": "YOLAB_OUTPUT file_explorer_url (\\S+)"
          },
          "when": {
            "properties": {
              "file_explorer_enabled": {
                "const": true
              }
            }
          }
        },
        "file_explorer_password": {
          "type": "string",
          "title": "File explorer password",
          "format": "secret",
          "source": {
            "logs": "YOLAB_OUTPUT file_explorer_password (\\S+)"
          },
          "when": {
            "properties": {
              "file_explorer_enabled": {
                "const": true
              }
            }
          }
        }
      }
    }
  }
}
