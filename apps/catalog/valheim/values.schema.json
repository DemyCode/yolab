{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Valheim",
      "type": "object",
      "required": [
        "server_name",
        "server_pass"
      ],
      "properties": {
        "server_name": {
          "type": "string",
          "title": "Server name",
          "default": "My Valheim Server"
        },
        "world_name": {
          "type": "string",
          "title": "World name",
          "default": "Dedicated"
        },
        "server_pass": {
          "type": "string",
          "title": "Server password",
          "description": "Minimum 5 characters",
          "writeOnly": true,
          "generate": true
        },
        "server_public": {
          "type": "boolean",
          "title": "List on public server browser",
          "default": false
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "server_pass": {
          "type": "string",
          "title": "Server password",
          "format": "secret",
          "source": {
            "config": "server_pass"
          }
        },
        "ipv6": {
          "type": "string",
          "title": "IPv6 Address",
          "format": "text",
          "source": {
            "logs": "YOLAB_OUTPUT ipv6 (\\S+)"
          }
        }
      }
    }
  }
}
