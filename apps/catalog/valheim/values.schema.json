{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Valheim",
      "type": "object",
      "required": [
        "server_name",
        "server_pass"
      ],
      "properties": {
        "server_name": {
          "type": "string",
          "title": "Server name",
          "default": "My Valheim Server"
        },
        "world_name": {
          "type": "string",
          "title": "World name",
          "default": "Dedicated"
        },
        "server_pass": {
          "type": "string",
          "title": "Server password",
          "description": "Minimum 5 characters"
        },
        "server_public": {
          "type": "boolean",
          "title": "List on public server browser",
          "default": false
        }
      }
    },
    "yolab": {
      "type": "object",
      "description": "Injected by local-api at install time; not user-editable.",
      "properties": {
        "platformApiUrl": {
          "type": "string"
        },
        "accountToken": {
          "type": "string"
        },
        "serviceName": {
          "type": "string"
        },
        "images": {
          "type": "object"
        },
        "gateway": {
          "type": "object",
          "properties": {
            "upstream": {
              "type": "string"
            },
            "caddyfile": {
              "type": "string"
            },
            "pvcName": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
