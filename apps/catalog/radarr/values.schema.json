{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Radarr",
      "type": "object",
      "properties": {
        "files_folder_existing": {
          "type": "boolean",
          "title": "Use an existing folder",
          "default": false,
          "description": "Off: the service gets a new folder of its own, named after it. On: pick a folder already in your file tree; every service set to the same folder sees the same files."
        },
        "movies_path": {
          "type": "string",
          "title": "Films folder",
          "default": "movies",
          "pattern": "^[A-Za-z0-9_ -][A-Za-z0-9._ -]*(/[A-Za-z0-9_ -][A-Za-z0-9._ -]*)*$",
          "description": "Where Radarr keeps your films, inside its files folder."
        },
        "yolab_enabled": {
          "type": "boolean",
          "title": "YoLab address",
          "default": true,
          "description": "Reachable from anywhere at https://<subdomain>.<your-number>.yolab.io, through your YoLab tunnel. Visitors need IPv6."
        },
        "api_key": {
          "type": "string",
          "title": "API key",
          "writeOnly": true,
          "generate": true,
          "pattern": "^([A-Za-z0-9]{20,})?$",
          "description": "What other apps use to talk to Radarr. Leave it as it is to keep the key Radarr has now."
        },
        "download_client": {
          "type": "object",
          "title": "Download client",
          "description": "The qBittorrent Radarr sends films to. Radarr keeps one download client called \"qBittorrent (YoLab)\" set to it and leaves the ones you add yourself alone.",
          "properties": {
            "internal_url": {
              "type": "string",
              "title": "Address",
              "format": "uri"
            },
            "username": {
              "type": "string",
              "title": "Username"
            },
            "password": {
              "type": "string",
              "title": "Password"
            }
          }
        }
      },
      "dependencies": {
        "files_folder_existing": {
          "oneOf": [
            {
              "properties": {
                "files_folder_existing": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "files_folder_existing": {
                  "const": true
                },
                "files_folder": {
                  "type": "string",
                  "title": "Files folder",
                  "format": "tree-folder",
                  "minLength": 1,
                  "pattern": "^$|^/?[A-Za-z0-9_ -][A-Za-z0-9._ -]*(/[A-Za-z0-9_ -][A-Za-z0-9._ -]*)*/?$",
                  "description": "Start typing to see the folders in your file tree; only a folder that exists can be picked."
                }
              },
              "required": [
                "files_folder"
              ]
            }
          ]
        },
        "yolab_enabled": {
          "oneOf": [
            {
              "properties": {
                "yolab_enabled": {
                  "const": false
                }
              },
              "required": [
                "yolab_enabled"
              ]
            },
            {
              "properties": {
                "yolab_enabled": {
                  "const": true
                },
                "subdomain": {
                  "type": "string",
                  "title": "Subdomain",
                  "format": "tunnel",
                  "default": "radarr"
                },
                "yolab_token": {
                  "type": "string",
                  "title": "YoLab token",
                  "format": "yolab-token",
                  "writeOnly": true,
                  "description": "Leave it as it is to use this box's YoLab account."
                }
              },
              "required": [
                "subdomain"
              ]
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "api_key": {
          "type": "string",
          "title": "API key",
          "format": "secret"
        }
      }
    }
  }
}
