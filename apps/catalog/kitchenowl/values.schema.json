{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "KitchenOwl",
      "type": "object",
      "properties": {
        "yolab_enabled": {
          "type": "boolean",
          "title": "YoLab address",
          "default": true,
          "description": "Reachable from anywhere at https://<subdomain>.<your-number>.yolab.io, through your YoLab tunnel. Visitors need IPv6."
        },
        "admin_password": {
          "type": "string",
          "title": "Admin password",
          "minLength": 12,
          "writeOnly": true,
          "generate": true
        },
        "oidc_enabled": {
          "type": "boolean",
          "title": "Sign in with Authelia",
          "default": false,
          "description": "KitchenOwl shows a \"Sign in with Authelia\" button. People use their Authelia account, and KitchenOwl knows who they are. Its own logins keep working."
        }
      },
      "dependencies": {
        "yolab_enabled": {
          "oneOf": [
            {
              "properties": {
                "yolab_enabled": {
                  "const": false
                }
              },
              "required": [
                "yolab_enabled"
              ]
            },
            {
              "properties": {
                "yolab_enabled": {
                  "const": true
                },
                "subdomain": {
                  "type": "string",
                  "title": "Subdomain",
                  "format": "tunnel",
                  "default": "kitchenowl"
                },
                "yolab_token": {
                  "type": "string",
                  "title": "YoLab token",
                  "format": "yolab-token",
                  "writeOnly": true,
                  "description": "Leave it as it is to use this box's YoLab account."
                }
              },
              "required": [
                "subdomain"
              ]
            }
          ]
        },
        "oidc_enabled": {
          "oneOf": [
            {
              "properties": {
                "oidc_enabled": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "oidc_enabled": {
                  "const": true
                },
                "auth_mode": {
                  "type": "string",
                  "title": "Which Authelia",
                  "default": "existing",
                  "oneOf": [
                    {
                      "const": "existing",
                      "title": "The Authelia service you already run, with its users"
                    },
                    {
                      "const": "own",
                      "title": "Its own Authelia, with the users below"
                    }
                  ]
                }
              },
              "required": [
                "auth_mode"
              ],
              "dependencies": {
                "auth_mode": {
                  "oneOf": [
                    {
                      "properties": {
                        "auth_mode": {
                          "const": "own"
                        },
                        "auth_users": {
                          "type": "array",
                          "title": "Logins",
                          "description": "Who can sign in with Authelia here. Each person gets their own username and password.",
                          "default": [],
                          "items": {
                            "type": "object",
                            "required": [
                              "username",
                              "password"
                            ],
                            "properties": {
                              "username": {
                                "type": "string",
                                "title": "Username",
                                "pattern": "^[a-z0-9][a-z0-9._-]*$"
                              },
                              "password": {
                                "type": "string",
                                "title": "Password",
                                "minLength": 8,
                                "writeOnly": true,
                                "generate": true
                              }
                            }
                          }
                        }
                      },
                      "required": [
                        "auth_users"
                      ]
                    },
                    {
                      "properties": {
                        "auth_mode": {
                          "const": "existing"
                        },
                        "auth_url": {
                          "type": "string",
                          "title": "Authelia address",
                          "format": "uri",
                          "description": "Copy the Authelia service's \"Address for your other services\" output. This service then signs itself up with that Authelia, and people sign in once for all your services that use it."
                        }
                      },
                      "required": [
                        "auth_url"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "url": {
          "type": "string",
          "title": "Web URL",
          "format": "uri"
        }
      }
    }
  }
}
