{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["config"],
  "properties": {
    "config": {
      "title": "OpenClaw",
      "type": "object",
      "required": ["subdomain", "gateway_token"],
      "properties": {
        "subdomain": {
          "type": "string",
          "title": "Subdomain",
          "format": "tunnel",
          "default": "openclaw"
        },
        "gateway_token": {
          "type": "string",
          "title": "Gateway access token",
          "minLength": 32,
          "description": "Protects the OpenClaw web UI. Everything else — your AI provider key, and linking WhatsApp/Telegram/Discord — is set up from inside OpenClaw itself after install."
        },
        "storage_size": {
          "type": "string",
          "title": "Storage size",
          "default": "5Gi",
          "description": "How much CephFS storage to allocate (e.g. 5Gi, 20Gi)"
        }
      }
    },
    "yolab": {
      "type": "object",
      "description": "Injected by local-api at install time; not user-editable.",
      "properties": {
        "platformApiUrl": { "type": "string" },
        "accountToken": { "type": "string" },
        "serviceName": { "type": "string" },
        "images": { "type": "object" },
        "gateway": {
          "type": "object",
          "properties": {
            "upstream": { "type": "string" },
            "caddyfile": { "type": "string" },
            "pvcName": { "type": "string" }
          }
        }
      }
    }
  }
}
