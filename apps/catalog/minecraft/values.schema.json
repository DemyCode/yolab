{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Minecraft",
      "type": "object",
      "required": [],
      "properties": {
        "difficulty": {
          "type": "string",
          "title": "Difficulty",
          "enum": [
            "peaceful",
            "easy",
            "normal",
            "hard"
          ],
          "default": "normal"
        },
        "gamemode": {
          "type": "string",
          "title": "Game mode",
          "enum": [
            "survival",
            "creative",
            "adventure",
            "spectator"
          ],
          "default": "survival"
        },
        "seed": {
          "type": "string",
          "title": "World seed",
          "description": "Leave blank for a random world."
        },
        "ops": {
          "type": "string",
          "title": "Operators (comma-separated usernames)"
        },
        "whitelist": {
          "type": "string",
          "title": "Whitelist (comma-separated usernames)"
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "ipv6": {
          "type": "string",
          "title": "IPv6 Address",
          "format": "text",
          "source": {
            "logs": "YOLAB_OUTPUT ipv6 (\\S+)"
          }
        }
      }
    }
  }
}
