{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["config"],
  "properties": {
    "config": {
      "title": "Minecraft",
      "type": "object",
      "required": [],
      "properties": {
        "difficulty": {
          "type": "string",
          "title": "Difficulty",
          "enum": ["peaceful", "easy", "normal", "hard"],
          "default": "normal"
        },
        "ops": {
          "type": "string",
          "title": "Operators (comma-separated usernames)"
        },
        "whitelist": {
          "type": "string",
          "title": "Whitelist (comma-separated usernames)"
        }
      }
    },
    "yolab": {
      "type": "object",
      "description": "Injected by local-api at install time; not user-editable.",
      "properties": {
        "platformApiUrl": { "type": "string" },
        "accountToken": { "type": "string" },
        "serviceName": { "type": "string" },
        "images": { "type": "object" },
        "gateway": {
          "type": "object",
          "properties": {
            "upstream": { "type": "string" },
            "caddyfile": { "type": "string" },
            "pvcName": { "type": "string" }
          }
        }
      }
    }
  }
}
