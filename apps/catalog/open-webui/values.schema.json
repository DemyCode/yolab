{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Open WebUI",
      "type": "object",
      "properties": {
        "yolab_enabled": {
          "type": "boolean",
          "title": "YoLab address",
          "default": true,
          "description": "Reachable from anywhere at https://<subdomain>.<your-number>.yolab.io, through your YoLab tunnel. Visitors need IPv6."
        },
        "ollama": {
          "type": "object",
          "title": "Ollama",
          "default": {},
          "description": "Where models run. Leave it empty to keep a private Ollama inside Open WebUI, or give the address of an Ollama to share its models with your other AI apps.",
          "properties": {
            "api": {
              "type": "string",
              "title": "Address",
              "format": "uri"
            }
          }
        },
        "unload_after": {
          "type": "string",
          "title": "Free the graphics card after",
          "default": "5m",
          "enum": [
            "1m",
            "5m",
            "30m",
            "24h"
          ],
          "description": "How long a model stays in graphics memory after its last answer. Shorter frees the card sooner for games and other apps; longer answers the next question faster."
        },
        "tor_enabled": {
          "type": "boolean",
          "title": "Tor",
          "default": false,
          "description": "Also reachable as a .onion address in Tor Browser, from any network and without IPv6. Slower than the normal address, and visitors never learn your home's IP address."
        },
        "tailscale_enabled": {
          "type": "boolean",
          "title": "Tailscale",
          "default": false,
          "description": "Also reachable from your own devices in your Tailscale network, at https://<name>.<your-tailnet>.ts.net, from any network and without IPv6. Turn on HTTPS certificates in the Tailscale admin console (DNS page) first."
        },
        "oidc_enabled": {
          "type": "boolean",
          "title": "Sign in with Authelia",
          "default": false,
          "description": "Open WebUI shows a \"Sign in with Authelia\" button. People use their Authelia account, and Open WebUI knows who they are. Its own logins keep working."
        }
      },
      "dependencies": {
        "yolab_enabled": {
          "oneOf": [
            {
              "properties": {
                "yolab_enabled": {
                  "const": false
                }
              },
              "required": [
                "yolab_enabled"
              ]
            },
            {
              "properties": {
                "yolab_enabled": {
                  "const": true
                },
                "subdomain": {
                  "type": "string",
                  "title": "Subdomain",
                  "format": "tunnel",
                  "default": "open-webui"
                },
                "yolab_token": {
                  "type": "string",
                  "title": "YoLab token",
                  "format": "yolab-token",
                  "writeOnly": true,
                  "description": "Leave it as it is to use this box's YoLab account."
                }
              },
              "required": [
                "subdomain"
              ]
            }
          ]
        },
        "tailscale_enabled": {
          "oneOf": [
            {
              "properties": {
                "tailscale_enabled": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "tailscale_enabled": {
                  "const": true
                },
                "tailscale_auth_key": {
                  "type": "string",
                  "title": "Tailscale auth key",
                  "writeOnly": true,
                  "pattern": "^tskey-",
                  "description": "Create one in the Tailscale admin console under Settings, Keys. It is used only the first time; after that the app stays signed in."
                },
                "tailscale_hostname": {
                  "type": "string",
                  "title": "Tailscale name",
                  "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
                  "description": "This app's device name in your tailnet. Leave empty to use its subdomain."
                }
              },
              "required": [
                "tailscale_auth_key"
              ]
            }
          ]
        },
        "oidc_enabled": {
          "oneOf": [
            {
              "properties": {
                "oidc_enabled": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "oidc_enabled": {
                  "const": true
                },
                "auth_mode": {
                  "type": "string",
                  "title": "Which Authelia",
                  "default": "existing",
                  "oneOf": [
                    {
                      "const": "existing",
                      "title": "The Authelia service you already run, with its users"
                    },
                    {
                      "const": "own",
                      "title": "Its own Authelia, with the users below"
                    }
                  ]
                }
              },
              "required": [
                "auth_mode"
              ],
              "dependencies": {
                "auth_mode": {
                  "oneOf": [
                    {
                      "properties": {
                        "auth_mode": {
                          "const": "own"
                        },
                        "auth_users": {
                          "type": "array",
                          "title": "Logins",
                          "description": "Who can sign in with Authelia here. Each person gets their own username and password.",
                          "default": [],
                          "items": {
                            "type": "object",
                            "required": [
                              "username",
                              "password"
                            ],
                            "properties": {
                              "username": {
                                "type": "string",
                                "title": "Username",
                                "pattern": "^[a-z0-9][a-z0-9._-]*$"
                              },
                              "password": {
                                "type": "string",
                                "title": "Password",
                                "minLength": 8,
                                "writeOnly": true,
                                "generate": true
                              }
                            }
                          }
                        }
                      },
                      "required": [
                        "auth_users"
                      ]
                    },
                    {
                      "properties": {
                        "auth_mode": {
                          "const": "existing"
                        },
                        "auth_url": {
                          "type": "string",
                          "title": "Authelia address",
                          "format": "uri",
                          "description": "Copy the Authelia service's \"Address for your other services\" output. This service then signs itself up with that Authelia, and people sign in once for all your services that use it."
                        }
                      },
                      "required": [
                        "auth_url"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "url": {
          "type": "string",
          "title": "Web URL",
          "format": "uri"
        },
        "tor_url": {
          "type": "string",
          "title": "Tor address",
          "format": "uri"
        },
        "tailscale_url": {
          "type": "string",
          "title": "Tailscale address",
          "format": "uri"
        }
      }
    }
  }
}
