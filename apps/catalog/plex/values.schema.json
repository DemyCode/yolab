{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "title": "Plex",
      "type": "object",
      "properties": {
        "files_folder_existing": {
          "type": "boolean",
          "title": "Use an existing folder",
          "default": false,
          "description": "Off: the service gets a new folder of its own, named after it. On: pick a folder already in your file tree; every service set to the same folder sees the same files."
        },
        "yolab_enabled": {
          "type": "boolean",
          "title": "YoLab address",
          "default": true,
          "description": "Reachable from anywhere at https://<subdomain>.<your-number>.yolab.io, through your YoLab tunnel. Visitors need IPv6."
        },
        "node": {
          "type": "string",
          "title": "Machine",
          "default": "",
          "description": "This app joins the machine's own network to reach devices on your LAN, so it can only run on one machine at a time. Name that machine here (the hostname shown in the fleet list); leave empty to let YoLab choose. Two apps doing this cannot share a machine unless their ports differ."
        }
      },
      "dependencies": {
        "files_folder_existing": {
          "oneOf": [
            {
              "properties": {
                "files_folder_existing": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "files_folder_existing": {
                  "const": true
                },
                "files_folder": {
                  "type": "string",
                  "title": "Files folder",
                  "format": "tree-folder",
                  "minLength": 1,
                  "pattern": "^$|^/?[A-Za-z0-9_ -][A-Za-z0-9._ -]*(/[A-Za-z0-9_ -][A-Za-z0-9._ -]*)*/?$",
                  "description": "Start typing to see the folders in your file tree; only a folder that exists can be picked."
                }
              },
              "required": [
                "files_folder"
              ]
            }
          ]
        },
        "yolab_enabled": {
          "oneOf": [
            {
              "properties": {
                "yolab_enabled": {
                  "const": false
                }
              },
              "required": [
                "yolab_enabled"
              ]
            },
            {
              "properties": {
                "yolab_enabled": {
                  "const": true
                },
                "subdomain": {
                  "type": "string",
                  "title": "Subdomain",
                  "format": "tunnel",
                  "default": "plex"
                },
                "yolab_token": {
                  "type": "string",
                  "title": "YoLab token",
                  "format": "yolab-token",
                  "writeOnly": true,
                  "description": "Leave it as it is to use this box's YoLab account."
                }
              },
              "required": [
                "subdomain"
              ]
            }
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "url": {
          "type": "string",
          "title": "Web URL",
          "format": "uri"
        }
      }
    }
  }
}
